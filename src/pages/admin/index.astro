---
/**
 * 写作台（Sveltia CMS）
 * 使用独立页面避免被 [...page] 通配路由拦截。
 * 配置：/admin/config.yml
 */
export const prerender = true;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>写作台 · 清哥的小屋</title>
		<style>
			/* 关键：让 Sveltia absolute loading 有正确的视口参照 */
			html {
				height: 100%;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				width: 100%;
				height: 100%;
				min-height: 100%;
				min-height: 100dvh;
				background: #f3f4f6;
				color: #3d342c;
				font-family:
					system-ui,
					-apple-system,
					"Segoe UI",
					Roboto,
					"PingFang SC",
					"Noto Sans SC",
					sans-serif;
			}
			body {
				position: relative;
				overflow-x: hidden;
			}

			/* CMS 挂载根必须撑满视口（absolute 子元素依赖此高度） */
			body > div:not(#admin-boot),
			#nc-root,
			.sui.app-shell {
				position: relative !important;
				box-sizing: border-box !important;
				width: 100% !important;
				min-height: 100% !important;
				min-height: 100dvh !important;
				height: 100% !important;
				height: 100dvh !important;
			}

			/*
			 * Sveltia 欢迎/Loading：.container { position:absolute; inset:0 }
			 * 父级高度不足时会整体偏上 → 强制 fixed 贴满视口并 flex 居中
			 */
			.sui.app-shell > .container,
			div.container[role="none"] {
				position: fixed !important;
				inset: 0 !important;
				top: 0 !important;
				right: 0 !important;
				bottom: 0 !important;
				left: 0 !important;
				z-index: 100 !important;
				width: 100vw !important;
				width: 100dvw !important;
				height: 100vh !important;
				height: 100dvh !important;
				min-height: 100vh !important;
				min-height: 100dvh !important;
				max-height: none !important;
				display: flex !important;
				flex-direction: column !important;
				align-items: center !important;
				justify-content: center !important;
				box-sizing: border-box !important;
				margin: 0 !important;
				padding: 32px !important;
				transform: none !important;
			}

			.sui.app-shell > .container > .inner,
			div.container[role="none"] > .inner {
				display: flex !important;
				flex-direction: column !important;
				align-items: center !important;
				justify-content: center !important;
				margin: 0 auto !important;
				transform: none !important;
			}

			/* 启动遮罩：CMS 可交互前盖住原生 loading */
			#admin-boot {
				position: fixed;
				inset: 0;
				z-index: 2147483000;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.85rem;
				padding: 1.5rem;
				text-align: center;
				background:
					radial-gradient(ellipse 70% 50% at 50% 45%, rgba(255, 236, 210, 0.75), transparent 70%),
					#f3f4f6;
				transition:
					opacity 0.35s ease,
					visibility 0.35s ease;
			}
			#admin-boot.is-hidden {
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
			}
			#admin-boot .icon {
				width: 4.5rem;
				height: 4.5rem;
				border-radius: 1.15rem;
				display: grid;
				place-items: center;
				background: linear-gradient(160deg, #fff7ec, #f3e0c8);
				box-shadow:
					0 10px 28px rgba(120, 72, 28, 0.12),
					inset 0 1px 0 rgba(255, 255, 255, 0.75);
				animation: float 2.4s ease-in-out infinite;
			}
			#admin-boot .icon svg {
				width: 2.35rem;
				height: 2.35rem;
				color: #c45c26;
			}
			#admin-boot h1 {
				font-size: 1.35rem;
				margin: 0.35rem 0 0;
			}
			#admin-boot p {
				margin: 0;
				opacity: 0.72;
				font-size: 0.9rem;
				line-height: 1.55;
				max-width: 22rem;
			}
			#admin-boot a {
				color: #c45c26;
			}
			#admin-boot code {
				font-size: 0.8rem;
				background: rgba(0, 0, 0, 0.06);
				padding: 0.1em 0.35em;
				border-radius: 0.3em;
			}
			#admin-boot .dots {
				display: inline-flex;
				gap: 0.35rem;
				height: 0.9rem;
			}
			#admin-boot .dots span {
				width: 0.4rem;
				height: 0.4rem;
				border-radius: 999px;
				background: #c45c26;
				opacity: 0.35;
				animation: dot 1.05s ease-in-out infinite;
			}
			#admin-boot .dots span:nth-child(2) {
				animation-delay: 0.15s;
			}
			#admin-boot .dots span:nth-child(3) {
				animation-delay: 0.3s;
			}
			#admin-boot .meta {
				margin-top: 0.65rem !important;
				opacity: 0.5 !important;
				font-size: 0.8rem !important;
			}
			#admin-boot-retry {
				color: #c45c26;
				font-size: 0.9rem;
				font-weight: 600;
			}
			#admin-boot-retry.is-hidden,
			#admin-boot.is-failed .dots {
				display: none;
			}
			@keyframes float {
				0%,
				100% {
					transform: translateY(0);
				}
				50% {
					transform: translateY(-6px);
				}
			}
			@keyframes dot {
				0%,
				80%,
				100% {
					opacity: 0.28;
					transform: translateY(0);
				}
				40% {
					opacity: 1;
					transform: translateY(-3px);
				}
			}
			@media (prefers-reduced-motion: reduce) {
				#admin-boot .icon,
				#admin-boot .dots span {
					animation: none;
				}
			}
		</style>
	</head>
	<body>
		<div id="admin-boot" role="status" aria-live="polite">
			<div class="icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
					<path
						d="M12 3.2 3.5 10.1c-.3.25-.4.65-.25 1 .15.35.5.55.9.55H6v7.1c0 .55.45 1 1 1h3.2v-4.4c0-.55.45-1 1-1h1.6c.55 0 1 .45 1 1V19.75H17c.55 0 1-.45 1-1v-7.1h1.85c.4 0 .75-.2.9-.55.15-.35.05-.75-.25-1L12 3.2Z"
					></path>
				</svg>
			</div>
			<h1>写作台 · 清哥的小屋</h1>
			<p id="admin-boot-status">正在加载 Sveltia CMS…</p>
			<div class="dots" aria-hidden="true"><span></span><span></span><span></span></div>
			<p>仅仓库协作者可登录。访客请返回 <a href="/">首页</a>。</p>
			<p class="meta">首次使用需配置 GitHub OAuth（见 <code>docs/DEPLOY.md</code>）。</p>
			<a id="admin-boot-retry" class="is-hidden" href="/admin/">重试</a>
		</div>

		<!-- 勿加 type="module"（Sveltia 文档要求） -->
		<script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"></script>
		<script is:inline>
			(function () {
				var boot = document.getElementById("admin-boot");
				var centerTimer = 0;
				var readyTimer = 0;
				var failureTimer = 0;
				var observer = null;

				function forceCenter(el) {
					if (!el) return;
					// 运行时再钉一次，防止 Sveltia 后续改写 style
					el.style.setProperty("position", "fixed", "important");
					el.style.setProperty("inset", "0", "important");
					el.style.setProperty("top", "0", "important");
					el.style.setProperty("left", "0", "important");
					el.style.setProperty("right", "0", "important");
					el.style.setProperty("bottom", "0", "important");
					el.style.setProperty("width", "100vw", "important");
					el.style.setProperty("height", "100vh", "important");
					el.style.setProperty("min-height", "100dvh", "important");
					el.style.setProperty("display", "flex", "important");
					el.style.setProperty("align-items", "center", "important");
					el.style.setProperty("justify-content", "center", "important");
					el.style.setProperty("margin", "0", "important");
					el.style.setProperty("transform", "none", "important");
					el.style.setProperty("z-index", "100", "important");
				}

				function nativeLoaderContainer() {
					var elements = document.querySelectorAll(".sui.app-shell p, .sui.app-shell div, .sui.app-shell span");
					for (var i = 0; i < elements.length; i++) {
						var element = elements[i];
						var text = (element.textContent || "").trim();
						if (text.indexOf("Loading Site Data") === -1) continue;

						var childHasLoaderText = false;
						for (var j = 0; j < element.children.length; j++) {
							if ((element.children[j].textContent || "").indexOf("Loading Site Data") !== -1) {
								childHasLoaderText = true;
								break;
							}
						}
						if (!childHasLoaderText) return element.closest(".container");
					}
					return null;
				}

				function scanCenter() {
					forceCenter(nativeLoaderContainer());

					// 根节点高度兜底
					var roots = document.querySelectorAll("body > div:not(#admin-boot), #nc-root, .sui.app-shell");
					for (var k = 0; k < roots.length; k++) {
						var r = roots[k];
						r.style.setProperty("position", "relative", "important");
						r.style.setProperty("min-height", "100dvh", "important");
						r.style.setProperty("height", "100dvh", "important");
						r.style.setProperty("width", "100%", "important");
					}
				}

				function cmsReady() {
					if (nativeLoaderContainer()) return false;
					var shell = document.querySelector(".sui.app-shell");
					return Boolean(
						shell &&
							shell.querySelector("button, [role='button'], input, .toolbar, [role='main']"),
					);
				}

				function stopWatching() {
					if (centerTimer) clearInterval(centerTimer);
					if (readyTimer) clearInterval(readyTimer);
					if (failureTimer) clearTimeout(failureTimer);
					if (observer) observer.disconnect();
				}

				function hideBoot() {
					if (!boot || boot.classList.contains("is-hidden")) return;
					stopWatching();
					boot.classList.add("is-hidden");
					setTimeout(function () {
						if (boot && boot.parentNode) boot.parentNode.removeChild(boot);
					}, 400);
				}

				function showFailure() {
					if (!boot || boot.classList.contains("is-hidden")) return;
					stopWatching();
					boot.classList.add("is-failed");
					var status = document.getElementById("admin-boot-status");
					var retry = document.getElementById("admin-boot-retry");
					if (status) status.textContent = "写作台加载失败，请检查网络后重试。";
					if (retry) retry.classList.remove("is-hidden");
				}

				// 持续纠正居中（Sveltia 挂载后 DOM 会变）
				scanCenter();
				centerTimer = setInterval(scanCenter, 200);

				if (typeof MutationObserver !== "undefined") {
					observer = new MutationObserver(function () {
						scanCenter();
						if (cmsReady()) {
							hideBoot();
						}
					});
					observer.observe(document.documentElement, { childList: true, subtree: true, characterData: true });
				}

				readyTimer = setInterval(function () {
					scanCenter();
					if (cmsReady()) {
						hideBoot();
					}
				}, 150);
				failureTimer = window.setTimeout(showFailure, 30000);
			})();
		</script>
	</body>
</html>
