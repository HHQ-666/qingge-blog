---
/**
 * 写作台（Sveltia CMS）。
 *
 * /admin/* 的主机白名单由根目录 middleware.js 在 Vercel 侧执行；
 * 这里不再输出口令，也不自行接收或验证 GitHub Token。
 */
export const prerender = true;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<title>写作台 · 清哥的小屋</title>
		<style is:global>
			html:has(body.admin-page),
			body.admin-page {
				margin: 0;
				padding: 0;
				width: 100%;
				height: 100%;
				min-height: 100%;
				min-height: 100dvh;
				--admin-shell-width: 1000px;
				background: #f3f4f6;
				color: #3d342c;
				font-family:
					system-ui,
					-apple-system,
					"Segoe UI",
					Roboto,
					"PingFang SC",
					"Noto Sans SC",
					sans-serif;
			}
			body.admin-page {
				position: relative;
				overflow-x: hidden;
			}

			body.admin-page #nc-root,
			body.admin-page .sui.app-shell {
				position: relative !important;
				box-sizing: border-box !important;
				width: min(100%, var(--admin-shell-width)) !important;
				max-width: var(--admin-shell-width) !important;
				min-width: 0 !important;
				margin-inline: auto !important;
				min-height: 100% !important;
				min-height: 100dvh !important;
				height: 100% !important;
				height: 100dvh !important;
			}

			.qingge-center-target {
				position: fixed !important;
				inset: 0 !important;
				z-index: 100 !important;
				width: 100vw !important;
				width: 100dvw !important;
				height: 100vh !important;
				height: 100dvh !important;
				min-height: 100vh !important;
				min-height: 100dvh !important;
				display: flex !important;
				flex-direction: column !important;
				align-items: center !important;
				justify-content: center !important;
				box-sizing: border-box !important;
				margin: 0 !important;
				padding: 32px !important;
				transform: none !important;
			}
			.qingge-center-target > .inner {
				display: flex !important;
				flex-direction: column !important;
				align-items: center !important;
				justify-content: center !important;
				margin: 0 auto !important;
				transform: none !important;
			}

			#admin-loading {
				gap: 0.8rem;
				text-align: center;
				background:
					radial-gradient(ellipse 70% 50% at 50% 45%, rgba(255, 236, 210, 0.75), transparent 70%),
					#f3f4f6;
				transition: opacity 0.25s ease, visibility 0.25s ease;
			}
			#admin-loading.is-hidden {
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
			}
			#admin-loading .icon {
				width: 4.5rem;
				height: 4.5rem;
				border-radius: 1.15rem;
				display: grid;
				place-items: center;
				background: linear-gradient(160deg, #fff7ec, #f3e0c8);
				box-shadow:
					0 10px 28px rgba(120, 72, 28, 0.12),
					inset 0 1px 0 rgba(255, 255, 255, 0.75);
			}
			#admin-loading .icon svg {
				width: 2.35rem;
				height: 2.35rem;
				color: #c45c26;
			}
			#admin-loading h1 {
				font-size: 1.35rem;
				margin: 0.35rem 0 0;
			}
			#admin-loading p {
				margin: 0;
				opacity: 0.72;
				font-size: 0.9rem;
				line-height: 1.55;
				max-width: 24rem;
			}
			#admin-loading a {
				color: #c45c26;
			}
			#admin-loading .dots {
				display: inline-flex;
				gap: 0.35rem;
				height: 0.9rem;
			}
			#admin-loading .dots span {
				width: 0.4rem;
				height: 0.4rem;
				border-radius: 999px;
				background: #c45c26;
				opacity: 0.35;
				animation: admin-dot 1.05s ease-in-out infinite;
			}
			#admin-loading .dots span:nth-child(2) { animation-delay: 0.15s; }
			#admin-loading .dots span:nth-child(3) { animation-delay: 0.3s; }
			#admin-loading.is-failed .dots { display: none; }
			@keyframes admin-dot {
				0%, 80%, 100% { opacity: 0.28; transform: translateY(0); }
				40% { opacity: 1; transform: translateY(-3px); }
			}
			@media (prefers-reduced-motion: reduce) {
				#admin-loading .dots span { animation: none; }
			}
		</style>
	</head>
	<body class="admin-page">
		<div id="admin-loading" class="qingge-center-target" role="status" aria-live="polite">
			<div class="inner">
				<div class="icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
						<path d="M12 3.2 3.5 10.1c-.3.25-.4.65-.25 1 .15.35.5.55.9.55H6v7.1c0 .55.45 1 1 1h3.2v-4.4c0-.55.45-1 1-1h1.6c.55 0 1 .45 1 1V19.75H17c.55 0 1-.45 1-1v-7.1h1.85c.4 0 .75-.2.9-.55.15-.35.05-.75-.25-1L12 3.2Z"></path>
					</svg>
				</div>
				<h1>写作台 · 清哥的小屋</h1>
				<p id="admin-loading-status">正在加载 Sveltia 写作台…</p>
				<div class="dots" aria-hidden="true"><span></span><span></span><span></span></div>
				<noscript><p>需要启用 JavaScript 才能打开写作台。访客请返回 <a href="/">首页</a>。</p></noscript>
			</div>
		</div>
		<script is:inline src="/admin/bootstrap.js" defer></script>
	</body>
</html>
