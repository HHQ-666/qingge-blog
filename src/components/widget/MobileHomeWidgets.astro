---
import { Icon } from "astro-icon/components";
import { funConfig } from "../../config";
import { getCategoryList, getTagList } from "../../utils/content-utils";
import { getTagUrl } from "../../utils/url-utils";

const categories = await getCategoryList();
const tags = await getTagList();
const primaryCategories = categories.slice(0, 3);
const extraCategories = categories.slice(3);
const primaryTags = tags.slice(0, 5);
const extraTags = tags.slice(5);

const siteDays = funConfig.siteDays;
const showSiteDays = siteDays.enable && Boolean(siteDays.startDate);
const startDate = showSiteDays ? new Date(`${siteDays.startDate}T00:00:00`) : null;
const days = startDate
	? Math.max(1, Math.floor((Date.now() - startDate.getTime()) / 86400000) + 1)
	: 0;
---

<mobile-home-widgets
	class="card-base mobile-home-widgets block lg:hidden"
	aria-label="文章导航与站点动态"
	data-site-days-start={showSiteDays ? siteDays.startDate : undefined}
>
	<div class="mobile-home-widgets__section">
		<div class="mobile-home-widgets__label">
			<Icon name="material-symbols:folder-rounded" />
			<span>分类</span>
		</div>
		<div class="mobile-home-widgets__links">
			{primaryCategories.map((category) => (
				<a href={category.url} class="mobile-home-widgets__pill">
					{category.name}
				</a>
			))}
			{extraCategories.length > 0 && (
				<button
					type="button"
					class="mobile-home-widgets__more"
					data-mobile-toggle="categories"
					aria-expanded="false"
					aria-controls="mobile-extra-categories"
				>
					更多
					<Icon name="material-symbols:expand-more-rounded" />
				</button>
			)}
		</div>
		{extraCategories.length > 0 && (
			<div id="mobile-extra-categories" class="mobile-home-widgets__extra" data-mobile-panel="categories" hidden>
				{extraCategories.map((category) => (
					<a href={category.url} class="mobile-home-widgets__pill">
						{category.name}
					</a>
				))}
			</div>
		)}
	</div>

	<div class="mobile-home-widgets__section mobile-home-widgets__section--bordered">
		<div class="mobile-home-widgets__label">
			<Icon name="material-symbols:tag-rounded" />
			<span>标签</span>
		</div>
		<div class="mobile-home-widgets__links">
			{primaryTags.map((tag) => (
				<a href={getTagUrl(tag.name)} class="mobile-home-widgets__pill">
					{tag.name}
				</a>
			))}
			{extraTags.length > 0 && (
				<button
					type="button"
					class="mobile-home-widgets__more"
					data-mobile-toggle="tags"
					aria-expanded="false"
					aria-controls="mobile-extra-tags"
				>
					全部标签
					<Icon name="material-symbols:expand-more-rounded" />
				</button>
			)}
		</div>
		{extraTags.length > 0 && (
			<div id="mobile-extra-tags" class="mobile-home-widgets__extra" data-mobile-panel="tags" hidden>
				{extraTags.map((tag) => (
					<a href={getTagUrl(tag.name)} class="mobile-home-widgets__pill">
						{tag.name}
					</a>
				))}
			</div>
		)}
	</div>

	{funConfig.hitokoto && (
		<div class="mobile-home-widgets__quote">
			<div class="mobile-home-widgets__quote-heading">
				<Icon name="material-symbols:format-quote-rounded" class="mobile-home-widgets__quote-icon" />
				<span>今日一言</span>
			</div>
			<div class="mobile-home-widgets__quote-content">
				<blockquote class="mobile-home-widgets__quote-text" data-mobile-quote-text>加载中…</blockquote>
				<div class="mobile-home-widgets__quote-footer">
					<p class="text-50 text-xs truncate" data-mobile-quote-from>—</p>
					<button
						type="button"
						class="btn-plain rounded-lg h-8 w-8 shrink-0 active:scale-90"
						data-mobile-quote-refresh
						aria-label="换一句"
						title="换一句"
					>
						<Icon name="material-symbols:refresh-rounded" class="text-[1.1rem]" />
					</button>
				</div>
			</div>
		</div>
	)}

	{showSiteDays && (
		<details class="mobile-home-widgets__days">
			<summary>
				<span class="mobile-home-widgets__days-summary">
					<Icon name="material-symbols:nest-clock-farsight-analog-outline-rounded" />
					<span>小屋已亮灯 <strong data-mobile-site-days>{days}</strong> 天</span>
				</span>
				<Icon name="material-symbols:expand-more-rounded" class="mobile-home-widgets__days-chevron" />
			</summary>
			<div class="mobile-home-widgets__days-detail text-50 text-xs">
				<p>从 {siteDays.startDate} 起，一点点堆起的文字与风景。</p>
			</div>
		</details>
	)}
</mobile-home-widgets>

<style>
	.mobile-home-widgets {
		padding: 0.75rem 1rem;
		margin-bottom: 0.75rem;
		box-shadow: 0 10px 28px -24px oklch(0.52 0.1 var(--hue) / 0.55);
	}
	.mobile-home-widgets__section {
		display: grid;
		grid-template-columns: 4.25rem minmax(0, 1fr);
		align-items: start;
		column-gap: 0.75rem;
		min-width: 0;
	}
	.mobile-home-widgets__section--bordered,
	.mobile-home-widgets__quote,
	.mobile-home-widgets__days {
		border-top: 1px solid oklch(0.75 0.04 var(--hue) / 0.22);
		margin-top: 0.75rem;
		padding-top: 0.75rem;
	}
	.mobile-home-widgets__label,
	.mobile-home-widgets__quote-heading,
	.mobile-home-widgets__days-summary {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: oklch(0.36 0.02 var(--hue));
		font-size: 0.82rem;
		font-weight: 700;
		white-space: nowrap;
	}
	.mobile-home-widgets__label > :first-child,
	.mobile-home-widgets__quote-icon,
	.mobile-home-widgets__days-summary > :first-child {
		color: var(--primary);
		font-size: 1.05rem;
	}
	.mobile-home-widgets__label {
		grid-column: 1;
		padding-top: 0.35rem;
	}
	.mobile-home-widgets__links,
	.mobile-home-widgets__extra {
		display: flex;
		align-items: flex-start;
		gap: 0.4rem;
		min-width: 0;
		flex-wrap: wrap;
	}
	.mobile-home-widgets__extra[hidden] {
		display: none;
	}
	.mobile-home-widgets__links {
		grid-column: 2;
		justify-content: flex-start;
	}
	.mobile-home-widgets__extra {
		grid-column: 2;
		padding-top: 0.2rem;
	}
	.mobile-home-widgets__pill,
	.mobile-home-widgets__more {
		display: inline-flex;
		align-items: center;
		height: 1.8rem;
		border-radius: 0.55rem;
		padding: 0 0.6rem;
		font-size: 0.75rem;
		line-height: 1;
		transition: 160ms ease;
	}
	.mobile-home-widgets__pill {
		background: oklch(0.93 0.05 var(--hue) / 0.7);
		color: oklch(0.52 0.13 var(--hue));
	}
	.mobile-home-widgets__pill:hover,
	.mobile-home-widgets__pill:focus-visible {
		background: var(--btn-regular-bg-hover);
		color: var(--btn-content);
	}
	.mobile-home-widgets__more {
		border: 0;
		background: transparent;
		color: var(--primary);
		font-weight: 700;
		cursor: pointer;
	}
	.mobile-home-widgets__more:hover,
	.mobile-home-widgets__more:focus-visible {
		background: var(--btn-plain-bg-hover);
	}
	.mobile-home-widgets__more > :last-child {
		font-size: 1rem;
		transition: transform 160ms ease;
	}
	.mobile-home-widgets__more[aria-expanded="true"] > :last-child {
		transform: rotate(180deg);
	}
	.mobile-home-widgets__quote-heading {
		margin-bottom: 0.3rem;
	}
	.mobile-home-widgets__quote-content {
		padding-left: 1.4rem;
	}
	.mobile-home-widgets__quote-text {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		color: oklch(0.4 0.02 var(--hue));
		font-size: 0.84rem;
		line-height: 1.55;
		min-height: 1.55em;
	}
	.mobile-home-widgets__quote-text.is-revealed {
		animation: quote-reveal 360ms ease-out both;
	}
	.mobile-home-widgets__quote-icon.is-revealed {
		animation: quote-icon-pop 300ms ease-out both;
	}
	.mobile-home-widgets__quote-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.2rem;
	}
	.mobile-home-widgets__days summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		cursor: pointer;
		list-style: none;
	}
	.mobile-home-widgets__days summary::-webkit-details-marker {
		display: none;
	}
	.mobile-home-widgets__days-summary strong {
		color: var(--primary);
		font-size: 1rem;
		padding: 0 0.15rem;
	}
	.mobile-home-widgets__days-chevron {
		color: var(--primary);
		transition: transform 160ms ease;
	}
	.mobile-home-widgets__days[open] .mobile-home-widgets__days-chevron {
		transform: rotate(180deg);
	}
	.mobile-home-widgets__days-detail {
		padding: 0.5rem 0 0 1.4rem;
		line-height: 1.5;
	}
	:global(.dark) .mobile-home-widgets__section--bordered,
	:global(.dark) .mobile-home-widgets__quote,
	:global(.dark) .mobile-home-widgets__days {
		border-color: oklch(0.62 0.04 var(--hue) / 0.24);
	}
	:global(.dark) .mobile-home-widgets__label,
	:global(.dark) .mobile-home-widgets__quote-heading,
	:global(.dark) .mobile-home-widgets__days-summary,
	:global(.dark) .mobile-home-widgets__quote-text {
		color: oklch(0.88 0.02 var(--hue));
	}
	@keyframes quote-reveal {
		from { opacity: 0; transform: translateY(0.35rem); }
		to { opacity: 1; transform: translateY(0); }
	}
	@keyframes quote-icon-pop {
		0% { transform: scale(0.75); }
		70% { transform: scale(1.12); }
		100% { transform: scale(1); }
	}
	@media (prefers-reduced-motion: reduce) {
		.mobile-home-widgets *,
		.mobile-home-widgets *::before,
		.mobile-home-widgets *::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>

<script>
	class MobileHomeWidgets extends HTMLElement {
		connectedCallback() {
			if (this.dataset.ready === "true") return;
			this.dataset.ready = "true";
			this.setupExpandControls();
			this.updateSiteDays();
			this.setupQuote();
		}

		setupExpandControls() {
			this.querySelectorAll<HTMLButtonElement>("[data-mobile-toggle]").forEach((button) => {
				button.addEventListener("click", () => {
					const key = button.dataset.mobileToggle;
					const panel = key
						? this.querySelector<HTMLElement>(`[data-mobile-panel="${key}"]`)
						: null;
					if (!panel) return;
					const expanded = button.getAttribute("aria-expanded") === "true";
					button.setAttribute("aria-expanded", String(!expanded));
					panel.hidden = expanded;
				});
			});
		}

		updateSiteDays() {
			const start = this.dataset.siteDaysStart;
			const days = this.querySelector<HTMLElement>("[data-mobile-site-days]");
			if (!start || !days) return;
			const startDate = new Date(`${start}T00:00:00`);
			const elapsed = Math.floor((Date.now() - startDate.getTime()) / 86400000) + 1;
			days.textContent = String(Math.max(1, elapsed));
		}

		setupQuote() {
			const text = this.querySelector<HTMLElement>("[data-mobile-quote-text]");
			const from = this.querySelector<HTMLElement>("[data-mobile-quote-from]");
			const refresh = this.querySelector<HTMLButtonElement>("[data-mobile-quote-refresh]");
			const icon = this.querySelector<HTMLElement>(".mobile-home-widgets__quote-icon");
			if (!text || !from) return;

			const reveal = () => {
				[text, icon].forEach((element) => {
					if (!element) return;
					element.classList.remove("is-revealed");
					void element.getBoundingClientRect();
					element.classList.add("is-revealed");
				});
			};

			const loadQuote = async () => {
				const controller = new AbortController();
				const timeout = window.setTimeout(() => controller.abort(), 4500);
				try {
					const response = await fetch("https://v1.hitokoto.cn/?c=i&c=k&c=d&encode=json", {
						signal: controller.signal,
					});
					if (!response.ok) throw new Error("Unable to load quote");
					const data = await response.json();
					text.textContent = data.hitokoto || "愿你眼里有光，心中有爱。";
					from.textContent = `— ${data.from_who || data.from || "佚名"}`;
				} catch {
					text.textContent = "愿你眼里有光，心中有爱。读过的书，走过的路，都算数。";
					from.textContent = "— 清哥的小屋";
				} finally {
					window.clearTimeout(timeout);
				}
				reveal();
			};

			void loadQuote();
			refresh?.addEventListener("click", () => void loadQuote());
		}
	}

	if (!customElements.get("mobile-home-widgets")) {
		customElements.define("mobile-home-widgets", MobileHomeWidgets);
	}
</script>
