---
import ImageWrapper from "./misc/ImageWrapper.astro";
import { siteConfig } from "../config";
import { url } from "../utils/url-utils";

const banner = siteConfig.banner;
const videoEnabled = Boolean(banner.video?.enable && banner.video?.src);
const staticSrc = banner.src;
const posterSrc = banner.video?.poster || banner.src;
const position = banner.position || "center";
// 走 base path，避免部署在子路径时 404
const videoSrc = banner.video?.src ? url(banner.video.src) : "";
---

{
	videoEnabled ? (
		<div
			id="banner"
			class="banner-media object-cover h-full relative overflow-hidden"
			data-video-enabled="1"
		>
			{/* 静态图负责首帧与播放失败兜底。 */}
			<div class="banner-media__static absolute inset-0" aria-hidden="true">
				<ImageWrapper
					src={staticSrc}
					alt=""
					position={position}
					class="w-full h-full"
				/>
			</div>

			<video
				id="banner-video"
				class="banner-media__video"
				src={videoSrc}
				style={`object-position: ${position}`}
				muted
				playsinline
				autoplay
				loop
				preload="metadata"
				aria-hidden="true"
			/>

			<div class="banner-media__poster absolute inset-0">
				<ImageWrapper
					src={posterSrc}
					alt="Banner poster"
					position={position}
					class="w-full h-full"
				/>
			</div>
		</div>
	) : (
		<ImageWrapper
			id="banner"
			alt="Banner image of the blog"
			class:list={["object-cover h-full banner-media--static"]}
			src={staticSrc}
			position={position}
		/>
	)
}

{
	videoEnabled && (
		<script is:inline>
			(function () {
				/** 多久没播出首帧就保留海报。 */
				const FAILSAFE_MS = 3500;

				const root = document.getElementById("banner");
				if (!root || root.getAttribute("data-video-enabled") !== "1") return;
				if (root.dataset.bannerBooted === "1") return;
				root.dataset.bannerBooted = "1";

				const video = document.getElementById("banner-video");
				const poster = root.querySelector(".banner-media__poster");
				if (!(video instanceof HTMLVideoElement)) return;

				// iOS 旧版：playsInline + webkit-playsinline 双保险。
				try {
					video.setAttribute("playsinline", "");
					video.setAttribute("webkit-playsinline", "");
					video.muted = true;
					video.defaultMuted = true;
					video.playsInline = true;
				} catch (_) {}

				let hasFrame = false;
				let failTimer = 0;

				function hidePoster() {
					if (poster) poster.classList.add("is-hidden");
					root.classList.add("is-playing");
					hasFrame = true;
					if (failTimer) {
						clearTimeout(failTimer);
						failTimer = 0;
					}
				}
				function showPoster() {
					if (poster) poster.classList.remove("is-hidden");
					root.classList.remove("is-playing");
				}

				function tryPlay() {
					try {
						video.muted = true;
						video.defaultMuted = true;
						video.playsInline = true;
					} catch (_) {}
					const p = video.play();
					if (p && typeof p.catch === "function") {
						p.catch(function () {
							// 自动播放被拒时保留海报；用户轻触后再试
						});
					}
				}

				function onFirstFrame() {
					hidePoster();
					video.removeEventListener("playing", onFirstFrame);
					video.removeEventListener("loadeddata", onFirstFrame);
				}

				function setupVideo() {
					video.addEventListener("playing", onFirstFrame, { once: true });
					video.addEventListener("loadeddata", onFirstFrame, { once: true });
					video.addEventListener("error", showPoster);
					tryPlay();
					// 超时仍未出帧：保留静态图/海报，不再空等黑屏
					failTimer = window.setTimeout(function () {
						if (!hasFrame) showPoster();
					}, FAILSAFE_MS);
				}

				function unlockOnce() {
					tryPlay();
				}
				document.addEventListener("touchstart", unlockOnce, { passive: true, once: true });
				document.addEventListener("click", unlockOnce, { once: true });

				// 等首屏绘制后再挂源，避免抢占关键资源
				if (typeof requestIdleCallback === "function") {
					requestIdleCallback(function () {
						setupVideo();
					}, { timeout: 800 });
				} else {
					window.setTimeout(setupVideo, 120);
				}

				document.addEventListener("swup:page:view", function () {
					tryPlay();
				});
				document.addEventListener("visibilitychange", function () {
					if (!document.hidden) tryPlay();
				});
			})();
		</script>
	)
}

<style>
	/* 不再依赖 JS 去掉 opacity-0：默认可见，避免移动端白屏 */
	.banner-media {
		opacity: 1;
		transform: scale(1);
		background: oklch(0.88 0.03 var(--hue));
	}
	:global(.dark) .banner-media {
		background: oklch(0.28 0.03 var(--hue));
	}
	.banner-media__static {
		z-index: 1;
		pointer-events: none;
	}
	.banner-media__poster {
		transition: opacity 500ms ease;
		pointer-events: none;
		z-index: 3;
	}
	.banner-media__poster.is-hidden {
		opacity: 0;
		z-index: 0;
	}
	/* 播放成功后可略降静态层（海报已隐藏） */
	.banner-media.is-playing .banner-media__static {
		opacity: 0;
		transition: opacity 400ms ease;
	}
	.banner-media__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 1;
		transition: opacity 420ms ease;
		z-index: 2;
		transform: translateZ(0);
		backface-visibility: hidden;
		background: transparent;
	}
	.banner-media--static {
		/* 纯静态模式：轻入场，不挡内容 */
		animation: banner-in 700ms ease both;
	}
	@keyframes banner-in {
		from {
			opacity: 0;
			transform: scale(1.05);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>
