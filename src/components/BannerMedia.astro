---
import ImageWrapper from "./misc/ImageWrapper.astro";
import { siteConfig } from "../config";
import { url } from "../utils/url-utils";

const banner = siteConfig.banner;
const videoEnabled = Boolean(banner.video?.enable && banner.video?.src);
const position = banner.position || "center";
// 走 base path，避免部署在子路径时 404
const videoSrc = banner.video?.src ? url(banner.video.src) : "";
// 原生 video poster 用 public 静态路径，首屏立刻有图，不依赖 Astro 哈希资源
const nativePoster = banner.video?.posterPublic
	? url(banner.video.posterPublic)
	: banner.video?.src
		? url(String(banner.video.src).replace(/\.mp4$/i, "-poster.jpg"))
		: "";
// 视频 poster 同时作为首屏静态图：加载、失败与自动播放受限时都不留空白。
const staticSrc = nativePoster || banner.video?.poster || banner.src;
---

{
	videoEnabled ? (
		<div
			id="banner"
			class="banner-media object-cover h-full relative overflow-hidden"
			data-video-enabled="1"
			data-video-src={videoSrc}
		>
			{/* 静态图：首屏立刻可见，视频加载前/失败时兜底 */}
			<div class="banner-media__static absolute inset-0" aria-hidden="true">
				<ImageWrapper
					src={staticSrc}
					alt=""
					position={position}
					class="w-full h-full"
				/>
			</div>

			{/* 不在 HTML 里写 src，避免首屏黑帧；由脚本在空闲时挂载 */}
			<video
				id="banner-video"
				class="banner-media__video"
				style={`object-position: ${position}`}
				poster={nativePoster || undefined}
				muted
				playsinline
				loop
				preload="none"
				aria-hidden="true"
			/>
		</div>
	) : (
		<ImageWrapper
			id="banner"
			alt="Banner image of the blog"
			class:list={["object-cover h-full banner-media--static"]}
			src={staticSrc}
			position={position}
		/>
	)
}

{
	videoEnabled && (
		<script is:inline>
			(function () {
				/** 多久没播出首帧就保留静态图 */
				const FAILSAFE_MS = 4000;

				const root = document.getElementById("banner");
				if (!root || root.getAttribute("data-video-enabled") !== "1") return;
				if (root.dataset.bannerBooted === "1") return;
				root.dataset.bannerBooted = "1";

				const video = document.getElementById("banner-video");
				const videoSrc = root.getAttribute("data-video-src") || "";
				if (!(video instanceof HTMLVideoElement) || !videoSrc) return;

				// iOS 旧版：playsInline + webkit-playsinline 双保险
				try {
					video.setAttribute("playsinline", "");
					video.setAttribute("webkit-playsinline", "");
					video.muted = true;
					video.defaultMuted = true;
					video.playsInline = true;
				} catch (_) {}

				let hasFrame = false;
				let failTimer = 0;
				let sourceAttached = false;

				function markPlaying() {
					if (hasFrame) return;
					hasFrame = true;
					root.classList.add("is-playing");
					if (failTimer) {
						clearTimeout(failTimer);
						failTimer = 0;
					}
				}

				function markFallback() {
					root.classList.remove("is-playing");
				}

				function tryPlay() {
					if (!sourceAttached) return;
					try {
						video.muted = true;
						video.defaultMuted = true;
						video.playsInline = true;
					} catch (_) {}
					const p = video.play();
					if (p && typeof p.catch === "function") {
						p.catch(function () {
							// 自动播放被拒时保留静态图；用户轻触后再试
						});
					}
				}

				function onFirstFrame() {
					markPlaying();
					video.removeEventListener("playing", onFirstFrame);
					video.removeEventListener("loadeddata", onFirstFrame);
					video.removeEventListener("canplay", onFirstFrame);
				}

				function attachSource() {
					if (sourceAttached) return;
					sourceAttached = true;
					// 真正开始拉视频时再挂 src，避免首屏抢带宽/黑帧
					video.src = videoSrc;
					video.setAttribute("preload", "metadata");
					video.addEventListener("playing", onFirstFrame, { once: true });
					video.addEventListener("loadeddata", onFirstFrame, { once: true });
					video.addEventListener("canplay", onFirstFrame, { once: true });
					video.addEventListener("error", markFallback);
					tryPlay();
					failTimer = window.setTimeout(function () {
						if (!hasFrame) markFallback();
					}, FAILSAFE_MS);
				}

				function unlockOnce() {
					if (!sourceAttached) attachSource();
					else tryPlay();
				}
				document.addEventListener("touchstart", unlockOnce, { passive: true, once: true });
				document.addEventListener("click", unlockOnce, { once: true });

				// 等首屏绘制后再挂源，静态图先占位
				if (typeof requestIdleCallback === "function") {
					requestIdleCallback(function () {
						attachSource();
					}, { timeout: 600 });
				} else {
					window.setTimeout(attachSource, 80);
				}

				document.addEventListener("swup:page:view", function () {
					tryPlay();
				});
				document.addEventListener("visibilitychange", function () {
					if (!document.hidden) tryPlay();
				});
			})();
		</script>
	)
}

<style>
	/* 默认可见：用静态图填满，避免移动端白屏/空白 */
	.banner-media {
		opacity: 1;
		transform: scale(1);
		background: var(--page-bg);
	}
	.banner-media__static {
		z-index: 1;
		pointer-events: none;
	}
	.banner-media__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* 未出首帧前完全透明，只露出下层静态图 */
		opacity: 0;
		transition: opacity 420ms ease;
		z-index: 2;
		transform: translateZ(0);
		backface-visibility: hidden;
		background: transparent;
	}
	.banner-media.is-playing .banner-media__video {
		opacity: 1;
	}
	/* 播放成功后可略降静态层（视频已盖住） */
	.banner-media.is-playing .banner-media__static {
		opacity: 0;
		transition: opacity 400ms ease;
	}
	.banner-media--static {
		animation: banner-in 700ms ease both;
	}
	@keyframes banner-in {
		from {
			opacity: 0;
			transform: scale(1.05);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>
