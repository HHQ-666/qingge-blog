---
import ImageWrapper from "./misc/ImageWrapper.astro";
import { siteConfig } from "../config";

const banner = siteConfig.banner;
const videoEnabled = Boolean(banner.video?.enable && banner.video?.src);
const staticSrc = banner.src;
const posterSrc = banner.video?.poster || banner.src;
const position = banner.position || "center";
const videoSrc = banner.video?.src || "";
---

{
	videoEnabled ? (
		<div
			id="banner"
			class="banner-media object-cover h-full transition duration-700 opacity-0 scale-105 relative overflow-hidden"
			data-video-src={videoSrc}
			data-video-enabled="1"
		>
			{/*
			  全端双视频交叉淡入：PC / 移动都播放。
			  无原生 loop 硬切；poster 作首帧与失败兜底。
			*/}
			<video
				id="banner-video-a"
				class="banner-media__video is-active"
				style={`object-position: ${position}`}
				muted
				playsinline
				webkit-playsinline
				preload="metadata"
				aria-hidden="true"
			/>
			<video
				id="banner-video-b"
				class="banner-media__video"
				style={`object-position: ${position}`}
				muted
				playsinline
				webkit-playsinline
				preload="metadata"
				aria-hidden="true"
			/>
			<div class="banner-media__poster absolute inset-0">
				<ImageWrapper
					src={posterSrc}
					alt="Banner poster"
					position={position}
					class="w-full h-full"
				/>
			</div>
		</div>
	) : (
		<ImageWrapper
			id="banner"
			alt="Banner image of the blog"
			class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
			src={staticSrc}
			position={position}
		/>
	)
}

{
	videoEnabled && (
		<script is:inline>
			(function () {
				/** 距片尾多少秒开始交叉淡入（掩盖 seek 卡顿） */
				const CROSSFADE_LEAD = 0.45;
				const CROSSFADE_MS = 420;

				const root = document.getElementById("banner");
				if (!root || root.getAttribute("data-video-enabled") !== "1") return;
				if (root.dataset.bannerBooted === "1") return;
				root.dataset.bannerBooted = "1";

				const videoSrc = root.getAttribute("data-video-src") || "";
				const va = document.getElementById("banner-video-a");
				const vb = document.getElementById("banner-video-b");
				const poster = root.querySelector(".banner-media__poster");
				if (
					!videoSrc ||
					!(va instanceof HTMLVideoElement) ||
					!(vb instanceof HTMLVideoElement)
				) {
					return;
				}

				let ready = false;
				/** @type {HTMLVideoElement} */
				let active = va;
				/** @type {HTMLVideoElement} */
				let standby = vb;
				let crossfading = false;
				let watchTimer = 0;

				function hidePoster() {
					if (poster) poster.classList.add("is-hidden");
				}
				function showPoster() {
					if (poster) poster.classList.remove("is-hidden");
				}

				function tryPlay(el) {
					const p = el.play();
					if (p && typeof p.catch === "function") {
						p.catch(function () {});
					}
				}

				function onFirstFrame() {
					hidePoster();
					va.removeEventListener("playing", onFirstFrame);
					va.removeEventListener("loadeddata", onFirstFrame);
				}

				function armSources() {
					va.setAttribute("src", videoSrc);
					vb.setAttribute("src", videoSrc);
					va.setAttribute("preload", "auto");
					vb.setAttribute("preload", "auto");
					try {
						va.load();
						vb.load();
					} catch (_) {}
				}

				function swapRoles() {
					const prev = active;
					active = standby;
					standby = prev;
					active.classList.add("is-active");
					standby.classList.remove("is-active");
					try {
						standby.pause();
						if (standby.readyState >= 1) {
							standby.currentTime = 0;
						}
					} catch (_) {}
					crossfading = false;
				}

				function beginCrossfade() {
					if (crossfading || !ready) return;

					const dur = active.duration;
					if (!isFinite(dur) || dur <= CROSSFADE_LEAD + 0.2) {
						try {
							active.currentTime = 0;
							tryPlay(active);
						} catch (_) {}
						return;
					}

					crossfading = true;
					try {
						if (standby.readyState < 2) {
							standby.load();
						}
						standby.currentTime = 0;
					} catch (_) {}
					tryPlay(standby);

					requestAnimationFrame(function () {
						standby.classList.add("is-active");
						active.classList.remove("is-active");
						window.setTimeout(swapRoles, CROSSFADE_MS);
					});
				}

				function startWatch() {
					if (watchTimer) return;
					watchTimer = window.setInterval(function () {
						if (!ready || crossfading || !active) return;
						// 页面不可见时不切换，省电
						if (document.hidden) return;
						const dur = active.duration;
						if (!isFinite(dur) || dur <= 0) return;
						const remain = dur - active.currentTime;
						if (remain <= CROSSFADE_LEAD && remain >= 0) {
							beginCrossfade();
						}
					}, 80);
				}

				function setupVideo() {
					if (!videoSrc) return;
					if (ready) {
						tryPlay(active);
						startWatch();
						return;
					}
					armSources();
					active = va;
					standby = vb;
					va.classList.add("is-active");
					vb.classList.remove("is-active");
					va.addEventListener("playing", onFirstFrame);
					va.addEventListener("loadeddata", onFirstFrame);
					va.addEventListener("error", showPoster);
					ready = true;
					tryPlay(va);
					startWatch();
				}

				// 用户轻触后再次尝试播放（兼容部分移动浏览器策略）
				function unlockOnce() {
					if (ready) tryPlay(active);
					document.removeEventListener("touchstart", unlockOnce);
					document.removeEventListener("click", unlockOnce);
				}
				document.addEventListener("touchstart", unlockOnce, { passive: true, once: true });
				document.addEventListener("click", unlockOnce, { once: true });

				setupVideo();
				document.addEventListener("swup:page:view", function () {
					if (ready) tryPlay(active);
					else setupVideo();
				});
				document.addEventListener("visibilitychange", function () {
					if (!document.hidden && ready) tryPlay(active);
				});
			})();
		</script>
	)
}

<style>
	.banner-media__poster {
		transition: opacity 500ms ease;
		pointer-events: none;
		z-index: 3;
	}
	.banner-media__poster.is-hidden {
		opacity: 0;
		z-index: 0;
	}
	.banner-media__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 420ms ease;
		z-index: 1;
		transform: translateZ(0);
		backface-visibility: hidden;
	}
	.banner-media__video.is-active {
		opacity: 1;
		z-index: 2;
	}
</style>
