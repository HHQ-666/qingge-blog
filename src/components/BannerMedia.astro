---
import ImageWrapper from "./misc/ImageWrapper.astro";
import { siteConfig } from "../config";

const banner = siteConfig.banner;
const videoEnabled = Boolean(banner.video?.enable && banner.video?.src);
/** 移动端静态大海图（与 PC 视频分离，避免手机下载 3MB 视频） */
const staticSrc = banner.src;
const posterSrc = banner.video?.poster || banner.src;
const position = banner.position || "center";
const videoSrc = banner.video?.src || "";
---

{
	videoEnabled ? (
		<div
			id="banner"
			class="banner-media object-cover h-full transition duration-700 opacity-0 scale-105 relative overflow-hidden"
			data-video-src={videoSrc}
			data-video-enabled="1"
		>
			{/* 移动端：仅静态图，DOM 里不带可播放 video 源 */}
			<div class="banner-media__static md:hidden absolute inset-0">
				<ImageWrapper
					src={staticSrc}
					alt="Banner image of the blog"
					position={position}
					class="w-full h-full"
				/>
			</div>

			{/*
			  桌面端：双视频交叉淡入淡出，避免原生 loop 跳回 0 时卡一下。
			  src 由脚本在桌面才挂载，移动端不请求 mp4。
			*/}
			<div class="banner-media__desktop absolute inset-0 hidden md:block" aria-hidden="true">
				<video
					id="banner-video-a"
					class="banner-media__video is-active"
					style={`object-position: ${position}`}
					muted
					playsinline
					preload="none"
				/>
				<video
					id="banner-video-b"
					class="banner-media__video"
					style={`object-position: ${position}`}
					muted
					playsinline
					preload="none"
				/>
				<div class="banner-media__poster absolute inset-0">
					<ImageWrapper
						src={posterSrc}
						alt="Banner poster"
						position={position}
						class="w-full h-full"
					/>
				</div>
			</div>
		</div>
	) : (
		<ImageWrapper
			id="banner"
			alt="Banner image of the blog"
			class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
			src={staticSrc}
			position={position}
		/>
	)
}

{
	videoEnabled && (
		<script is:inline>
			(function () {
				const DESKTOP_MQ = "(min-width: 768px)";
				/** 距片尾多少秒开始交叉淡入（掩盖 seek 卡顿） */
				const CROSSFADE_LEAD = 0.45;
				const CROSSFADE_MS = 420;

				const root = document.getElementById("banner");
				if (!root || root.getAttribute("data-video-enabled") !== "1") return;
				if (root.dataset.bannerBooted === "1") return;
				root.dataset.bannerBooted = "1";

				const videoSrc = root.getAttribute("data-video-src") || "";
				const va = document.getElementById("banner-video-a");
				const vb = document.getElementById("banner-video-b");
				const poster = root.querySelector(".banner-media__poster");
				if (
					!videoSrc ||
					!(va instanceof HTMLVideoElement) ||
					!(vb instanceof HTMLVideoElement)
				) {
					return;
				}

				let desktopReady = false;
				/** @type {HTMLVideoElement} */
				let active = va;
				/** @type {HTMLVideoElement} */
				let standby = vb;
				let crossfading = false;
				let watchTimer = 0;

				function hidePoster() {
					if (poster) poster.classList.add("is-hidden");
				}
				function showPoster() {
					if (poster) poster.classList.remove("is-hidden");
				}

				function clearSrc(el) {
					try {
						el.pause();
					} catch (_) {}
					el.removeAttribute("src");
					el.load();
				}

				function stopWatch() {
					if (watchTimer) {
						clearInterval(watchTimer);
						watchTimer = 0;
					}
				}

				function teardownVideo() {
					stopWatch();
					clearSrc(va);
					clearSrc(vb);
					va.classList.add("is-active");
					vb.classList.remove("is-active");
					active = va;
					standby = vb;
					crossfading = false;
					showPoster();
					desktopReady = false;
				}

				function tryPlay(el) {
					const p = el.play();
					if (p && typeof p.catch === "function") {
						p.catch(function () {});
					}
				}

				function onFirstFrame() {
					hidePoster();
					va.removeEventListener("playing", onFirstFrame);
					va.removeEventListener("loadeddata", onFirstFrame);
				}

				function armSources() {
					va.setAttribute("src", videoSrc);
					vb.setAttribute("src", videoSrc);
					va.setAttribute("preload", "auto");
					vb.setAttribute("preload", "auto");
					try {
						va.load();
						vb.load();
					} catch (_) {}
				}

				function swapRoles() {
					const prev = active;
					active = standby;
					standby = prev;
					active.classList.add("is-active");
					standby.classList.remove("is-active");
					try {
						standby.pause();
						if (standby.readyState >= 1) {
							standby.currentTime = 0;
						}
					} catch (_) {}
					crossfading = false;
				}

				function beginCrossfade() {
					if (crossfading || !desktopReady) return;
					if (!window.matchMedia(DESKTOP_MQ).matches) return;

					const dur = active.duration;
					if (!isFinite(dur) || dur <= CROSSFADE_LEAD + 0.2) {
						try {
							active.currentTime = 0;
							tryPlay(active);
						} catch (_) {}
						return;
					}

					crossfading = true;
					try {
						if (standby.readyState < 2) {
							standby.load();
						}
						standby.currentTime = 0;
					} catch (_) {}
					tryPlay(standby);

					requestAnimationFrame(function () {
						standby.classList.add("is-active");
						active.classList.remove("is-active");
						window.setTimeout(swapRoles, CROSSFADE_MS);
					});
				}

				function startWatch() {
					if (watchTimer) return;
					watchTimer = window.setInterval(function () {
						if (!desktopReady || !window.matchMedia(DESKTOP_MQ).matches) return;
						if (crossfading || !active) return;
						const dur = active.duration;
						if (!isFinite(dur) || dur <= 0) return;
						const remain = dur - active.currentTime;
						if (remain <= CROSSFADE_LEAD && remain >= 0) {
							beginCrossfade();
						}
					}, 80);
				}

				function setupDesktopVideo() {
					if (!videoSrc) return;
					if (desktopReady) {
						tryPlay(active);
						startWatch();
						return;
					}
					armSources();
					active = va;
					standby = vb;
					va.classList.add("is-active");
					vb.classList.remove("is-active");
					va.addEventListener("playing", onFirstFrame);
					va.addEventListener("loadeddata", onFirstFrame);
					va.addEventListener("error", showPoster);
					desktopReady = true;
					tryPlay(va);
					startWatch();
				}

				function syncToViewport() {
					if (window.matchMedia(DESKTOP_MQ).matches) {
						setupDesktopVideo();
					} else {
						teardownVideo();
					}
				}

				syncToViewport();
				const mql = window.matchMedia(DESKTOP_MQ);
				if (typeof mql.addEventListener === "function") {
					mql.addEventListener("change", syncToViewport);
				} else if (typeof mql.addListener === "function") {
					mql.addListener(syncToViewport);
				}
				document.addEventListener("swup:page:view", function () {
					if (window.matchMedia(DESKTOP_MQ).matches) {
						if (desktopReady) tryPlay(active);
						else setupDesktopVideo();
					}
				});
			})();
		</script>
	)
}

<style>
	.banner-media__desktop {
		z-index: 1;
	}
	.banner-media__poster {
		transition: opacity 500ms ease;
		pointer-events: none;
		z-index: 3;
	}
	.banner-media__poster.is-hidden {
		opacity: 0;
		z-index: 0;
	}
	.banner-media__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 420ms ease;
		z-index: 1;
		transform: translateZ(0);
		backface-visibility: hidden;
	}
	.banner-media__video.is-active {
		opacity: 1;
		z-index: 2;
	}
	.banner-media__static {
		z-index: 1;
	}
</style>
