---
import ImageWrapper from "./misc/ImageWrapper.astro";
import { siteConfig } from "../config";

const banner = siteConfig.banner;
const videoEnabled = Boolean(banner.video?.enable && banner.video?.src);
/** 移动端静态大海图（与 PC 视频分离，避免手机下载 3MB 视频） */
const staticSrc = banner.src;
const posterSrc = banner.video?.poster || banner.src;
const position = banner.position || "center";
const videoSrc = banner.video?.src || "";
---

{
	videoEnabled ? (
		<div
			id="banner"
			class="banner-media object-cover h-full transition duration-700 opacity-0 scale-105 relative overflow-hidden"
			data-video-src={videoSrc}
			data-video-enabled="1"
		>
			{/* 移动端：仅静态图，DOM 里不带可播放 video 源 */}
			<div class="banner-media__static md:hidden absolute inset-0">
				<ImageWrapper
					src={staticSrc}
					alt="Banner image of the blog"
					position={position}
					class="w-full h-full"
				/>
			</div>

			{/* 桌面端：视频 + poster 首帧；src 由脚本在桌面才挂载，避免移动端误下载 */}
			<video
				id="banner-video"
				class="banner-media__video absolute inset-0 w-full h-full object-cover hidden md:block"
				style={`object-position: ${position}`}
				muted
				loop
				playsinline
				preload="none"
				aria-hidden="true"
			/>
			<div class="banner-media__poster absolute inset-0 hidden md:block">
				<ImageWrapper
					src={posterSrc}
					alt="Banner poster"
					position={position}
					class="w-full h-full"
				/>
			</div>
		</div>
	) : (
		<ImageWrapper
			id="banner"
			alt="Banner image of the blog"
			class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
			src={staticSrc}
			position={position}
		/>
	)
}

{
	videoEnabled && (
		<script is:inline>
			(function () {
				const DESKTOP_MQ = "(min-width: 768px)";
				const root = document.getElementById("banner");
				const video = document.getElementById("banner-video");
				if (!root || !video || !(video instanceof HTMLVideoElement)) return;
				if (root.getAttribute("data-video-enabled") !== "1") return;

				const videoSrc = root.getAttribute("data-video-src") || "";
				const poster = root.querySelector(".banner-media__poster");
				let desktopReady = false;

				function hidePoster() {
					if (poster) poster.classList.add("is-hidden");
				}
				function showPoster() {
					if (poster) poster.classList.remove("is-hidden");
				}

				function teardownVideo() {
					try {
						video.pause();
					} catch (_) {}
					video.removeAttribute("src");
					while (video.firstChild) video.removeChild(video.firstChild);
					video.load();
					showPoster();
					desktopReady = false;
				}

				function setupDesktopVideo() {
					if (!videoSrc) return;
					if (desktopReady && video.getAttribute("src")) {
						tryPlay();
						return;
					}
					// 仅桌面挂载源，手机端永远不会请求 mp4
					video.setAttribute("src", videoSrc);
					video.setAttribute("autoplay", "");
					video.setAttribute("preload", "metadata");
					desktopReady = true;
					tryPlay();
				}

				function tryPlay() {
					const p = video.play();
					if (p && typeof p.catch === "function") p.catch(function () {});
				}

				function syncToViewport() {
					if (window.matchMedia(DESKTOP_MQ).matches) {
						setupDesktopVideo();
					} else {
						teardownVideo();
					}
				}

				video.addEventListener("loadeddata", hidePoster);
				video.addEventListener("playing", hidePoster);
				video.addEventListener("error", showPoster);

				syncToViewport();
				// 窗口跨断点时切换（如平板旋转）
				const mql = window.matchMedia(DESKTOP_MQ);
				if (typeof mql.addEventListener === "function") {
					mql.addEventListener("change", syncToViewport);
				} else if (typeof mql.addListener === "function") {
					mql.addListener(syncToViewport);
				}
				// Swup 页面切换后桌面端继续播
				document.addEventListener("swup:page:view", function () {
					if (window.matchMedia(DESKTOP_MQ).matches) tryPlay();
				});
			})();
		</script>
	)
}

<style>
	.banner-media__poster {
		transition: opacity 500ms ease;
		pointer-events: none;
		z-index: 2;
	}
	.banner-media__poster.is-hidden {
		opacity: 0;
		z-index: 0;
	}
	.banner-media__video {
		z-index: 1;
	}
	.banner-media__static {
		z-index: 1;
	}
</style>
