---
/**
 * 站内 Swup 跳转时的友好 loading：
 * - 顶部进度条（不定进度动画）
 * - 中央轻量小屋卡片
 */
---

<div id="page-loader" class="page-loader" aria-hidden="true" hidden>
	<div class="page-loader__bar" aria-hidden="true">
		<span class="page-loader__bar-inner"></span>
	</div>
	<div class="page-loader__panel" role="status" aria-live="polite">
		<div class="page-loader__icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
				<path
					d="M12 3.2 3.5 10.1c-.3.25-.4.65-.25 1 .15.35.5.55.9.55H6v7.1c0 .55.45 1 1 1h3.2v-4.4c0-.55.45-1 1-1h1.6c.55 0 1 .45 1 1V19.75H17c.55 0 1-.45 1-1v-7.1h1.85c.4 0 .75-.2.9-.55.15-.35.05-.75-.25-1L12 3.2Z"
				></path>
			</svg>
		</div>
		<div class="page-loader__text">正在前往…</div>
		<div class="page-loader__dots" aria-hidden="true">
			<span></span><span></span><span></span>
		</div>
	</div>
</div>

<script>
	(() => {
		const loader = document.getElementById("page-loader");
		if (!loader) return;

		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let hideTimer = 0;
		let shownAt = 0;
		const MIN_SHOW_MS = reduced ? 0 : 220;

		function show() {
			if (hideTimer) {
				clearTimeout(hideTimer);
				hideTimer = 0;
			}
			shownAt = performance.now();
			loader.hidden = false;
			loader.setAttribute("aria-hidden", "false");
			// 下一帧再加 class，触发 CSS 过渡
			requestAnimationFrame(() => {
				loader.classList.add("is-active");
			});
		}

		function hide() {
			const elapsed = performance.now() - shownAt;
			const wait = Math.max(0, MIN_SHOW_MS - elapsed);
			if (hideTimer) clearTimeout(hideTimer);
			hideTimer = window.setTimeout(() => {
				loader.classList.remove("is-active");
				loader.setAttribute("aria-hidden", "true");
				// 等淡出后再 hidden，避免闪断
				hideTimer = window.setTimeout(() => {
					if (!loader.classList.contains("is-active")) {
						loader.hidden = true;
					}
					hideTimer = 0;
				}, reduced ? 0 : 280);
			}, wait);
		}

		const setup = () => {
			const swup = window.swup;
			if (!swup?.hooks) return;
			// 同一会话避免重复绑定
			if ((loader as HTMLElement & { dataset: DOMStringMap }).dataset.bound === "1") return;
			loader.dataset.bound = "1";

			swup.hooks.on("visit:start", show);
			swup.hooks.on("page:view", hide);
			swup.hooks.on("visit:end", hide);
			// 失败/取消时也收起
			swup.hooks.on("fetch:error", hide);
			swup.hooks.on("visit:abort", hide);
		};

		if (window.swup?.hooks) {
			setup();
		} else {
			document.addEventListener("swup:enable", setup);
		}
	})();
</script>

<style is:global>
	.page-loader {
		position: fixed;
		inset: 0;
		z-index: 200;
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.28s ease,
			visibility 0.28s ease;
	}

	.page-loader.is-active {
		opacity: 1;
		visibility: visible;
	}

	.page-loader__bar {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		overflow: hidden;
		background: transparent;
	}

	.page-loader__bar-inner {
		display: block;
		height: 100%;
		width: 36%;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			oklch(0.78 0.12 var(--hue)),
			oklch(0.62 0.15 var(--hue)),
			oklch(0.78 0.12 var(--hue))
		);
		box-shadow: 0 0 12px oklch(0.65 0.12 var(--hue) / 0.5);
		transform: translateX(-120%);
	}

	.page-loader.is-active .page-loader__bar-inner {
		animation: page-loader-bar 1.05s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}

	.page-loader__panel {
		position: absolute;
		left: 50%;
		top: 42%;
		transform: translate(-50%, -50%) scale(0.96);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.45rem;
		min-width: 8.5rem;
		padding: 1rem 1.15rem 0.9rem;
		border-radius: 1rem;
		background: color-mix(in oklab, var(--card-bg) 92%, transparent);
		backdrop-filter: blur(12px) saturate(1.1);
		-webkit-backdrop-filter: blur(12px) saturate(1.1);
		box-shadow:
			0 12px 40px oklch(0.35 0.04 var(--hue) / 0.16),
			0 0 0 1px oklch(0.7 0.04 var(--hue) / 0.12);
		opacity: 0;
		transition:
			opacity 0.28s ease,
			transform 0.28s ease;
	}

	.page-loader.is-active .page-loader__panel {
		opacity: 1;
		transform: translate(-50%, -50%) scale(1);
	}

	.page-loader__icon {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.75rem;
		display: grid;
		place-items: center;
		color: var(--primary);
		background: oklch(0.95 0.03 var(--hue) / 0.9);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
	}

	:root.dark .page-loader__icon {
		background: oklch(0.32 0.04 var(--hue) / 0.9);
	}

	.page-loader__icon svg {
		width: 1.35rem;
		height: 1.35rem;
	}

	.page-loader.is-active .page-loader__icon {
		animation: page-loader-float 1.6s ease-in-out infinite;
	}

	.page-loader__text {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: oklch(0.4 0.04 var(--hue));
	}

	:root.dark .page-loader__text {
		color: oklch(0.86 0.03 var(--hue));
	}

	.page-loader__dots {
		display: inline-flex;
		gap: 0.28rem;
		height: 0.55rem;
		align-items: center;
	}

	.page-loader__dots span {
		width: 0.28rem;
		height: 0.28rem;
		border-radius: 999px;
		background: var(--primary);
		opacity: 0.3;
	}

	.page-loader.is-active .page-loader__dots span {
		animation: page-loader-dot 1s ease-in-out infinite;
	}

	.page-loader.is-active .page-loader__dots span:nth-child(2) {
		animation-delay: 0.14s;
	}

	.page-loader.is-active .page-loader__dots span:nth-child(3) {
		animation-delay: 0.28s;
	}

	@keyframes page-loader-bar {
		0% {
			transform: translateX(-120%);
		}
		50% {
			transform: translateX(140%);
		}
		100% {
			transform: translateX(320%);
		}
	}

	@keyframes page-loader-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	@keyframes page-loader-dot {
		0%,
		80%,
		100% {
			opacity: 0.25;
			transform: translateY(0);
		}
		40% {
			opacity: 1;
			transform: translateY(-2px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.page-loader,
		.page-loader__panel {
			transition: none;
		}
		.page-loader.is-active .page-loader__bar-inner,
		.page-loader.is-active .page-loader__icon,
		.page-loader.is-active .page-loader__dots span {
			animation: none;
		}
		.page-loader.is-active .page-loader__bar-inner {
			width: 100%;
			transform: none;
			opacity: 0.85;
		}
	}
</style>
