					}
				}
				if (seek) {
					seek.addEventListener("pointerdown", function () { seeking = true; });
					seek.addEventListener("pointerup", function () { seeking = false; });
					seek.addEventListener("input", function () {
						if (!audio || !audio.duration) return;
						audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
						if (curEl) curEl.textContent = fmt(audio.currentTime);
					});
				}

				function updateSummary(done, total) {
					var readyCount = songStates.filter(function (state) { return state.status === "ready"; }).length;
					var pendingCount = songStates.filter(function (state) { return state.status === "loading"; }).length;
					setLoadProgress(done, total, readyCount);
					if (tipEl) {
						if (!readyCount && !pendingCount) {
							tipEl.textContent = "暂无可用音源，但歌单仍保留";
						} else {
							tipEl.textContent = "共 " + songs.length + " 首 · 当前可播放 " + readyCount + " 首";
							if (pendingCount) tipEl.textContent += " · 正在获取 " + pendingCount + " 首";
						}
					}
					if (loadingTitle && !readyCount && !pendingCount) loadingTitle.textContent = "暂无可用音源";
					if (loadingSub && !readyCount && !pendingCount) loadingSub.textContent = "可稍后重试或更换 musicPlayer.api";
				}

				function applyCachedItems(items) {
					for (var i = 0; i < songStates.length; i++) {
						var state = songStates[i];
						var cached = items.find(function (item) { return String(item.id) === String(state.meta.id); });
						if (!cached || classifyDuration(cached.duration, minDurationSec) !== "ready") continue;
						state.status = "ready";
						state.item = cached;
						state.reason = "cache";
					}
					syncLoaded();
					buildList();
					if (loaded.length) playIndex(index || 0, false);
					showReady();
				}

				function applyFetchResult(stateIndex, result) {
					var state = songStates[stateIndex];
					if (!state) return;
					if (result && result.status === "ready" && result.item) {
						state.status = "ready";
						state.item = result.item;
						state.reason = "";
					} else {
						state.status = result?.status === "short" ? "short" : "failed";
						state.item = null;
						state.reason = result?.reason || "source-failed";
					}
					syncLoaded();
					buildList();
				}

				function retrySong(stateIndex) {
					var state = songStates[stateIndex];
					if (!state || state.status === "loading") return Promise.resolve(null);
					var currentId = loaded[index] && loaded[index].id;
					var hadReadySong = loaded.length > 0;
					state.status = "loading";
					state.reason = "";
					buildList();
					updateSummary(songs.length - songStates.filter(function (item) { return item.status === "loading"; }).length, songs.length);
					return fetchSong(state.meta).then(function (result) {
						applyFetchResult(stateIndex, result);
						if (currentId) {
							var nextIndex = loaded.findIndex(function (item) { return String(item.id) === String(currentId); });
							if (nextIndex >= 0) index = nextIndex;
						}
						if (!hadReadySong && loaded.length) playIndex(0, false);
						writeCache(loaded);
						updateSummary(songs.length - songStates.filter(function (item) { return item.status === "loading"; }).length, songs.length);
						return result;
					});
				}

				function fetchAll() {
					var targetIndexes = [];
					for (var i = 0; i < songStates.length; i++) {
						if (songStates[i].status === "loading") targetIndexes.push(i);
					}
						if (!targetIndexes.length) {
						updateSummary(songs.length, songs.length);
						showReady();
						return Promise.resolve();
					}
					buildList();
					showReady();
					setLoadProgress(songs.length - targetIndexes.length, songs.length, loaded.length);
					var cursor = 0;
					var completed = songs.length - targetIndexes.length;
					var concurrency = 2;
					function next() {
						if (cursor >= targetIndexes.length) return Promise.resolve();
						var stateIndex = targetIndexes[cursor++];
						return fetchSong(songStates[stateIndex].meta)
							.then(function (result) {
								applyFetchResult(stateIndex, result);
								completed++;
								updateSummary(completed, songs.length);
								return next();
							})
							.catch(function (error) {
								applyFetchResult(stateIndex, { status: "failed", reason: error?.message || "request-failed" });
								completed++;
								updateSummary(completed, songs.length);
								return next();
							});
					}
					var starters = [];
					for (var c = 0; c < Math.min(concurrency, targetIndexes.length); c++) starters.push(next());
					return Promise.all(starters).then(function () {
						syncLoaded();
						buildList();
						writeCache(loaded);
						updateSummary(songs.length, songs.length);
						if (loaded.length && (!songEl || songEl.textContent === "—" || !songEl.textContent)) playIndex(index || 0, false);
						showReady();
					});
				}

				function ensureLoaded() {
					if (loadPromise) return loadPromise;
					if (!songStates.some(function (state) { return state.status === "ready"; })) {
						var cached = readCache();
						if (cached && cached.length) applyCachedItems(cached);
					}
					loadPromise = fetchAll().catch(function (err) {
						console.error("[qingge-music] load failed", err);
						if (loadingTitle) loadingTitle.textContent = "加载失败";
						if (loadingSub) loadingSub.textContent = "请关闭后重试，或检查网络";
						loadPromise = null;
					});
					return loadPromise;
				}

				var cachedBoot = readCache();
				if (cachedBoot && cachedBoot.length) {
					applyCachedItems(cachedBoot);
					if (songStates.some(function (state) { return state.status === "loading"; })) {
						setTimeout(function () { ensureLoaded(); }, 1200);
					}
				} else if ("requestIdleCallback" in window) {
					requestIdleCallback(function () { ensureLoaded(); }, { timeout: 4000 });
				} else {
					setTimeout(function () { ensureLoaded(); }, 1200);
				}
			})();
		</script>
	)
