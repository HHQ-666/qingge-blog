---
/**
 * 华语金曲播放器
 * - 默认圆盘 FAB；点开完整面板（封面/进度/歌单）
 * - 面板内可切「精简模式」：迷你条（封面播放 + 上/下首）
 * - localStorage 缓存歌单，刷新页面不重复探测
 */
import { funConfig } from "../../config";
import { normalizeSongConfig } from "../../scripts/music-playlist-utils.mjs";

const conf = funConfig.musicPlayer;
const songs = normalizeSongConfig(conf?.songs);
const enabled = Boolean(conf?.enable && songs.length);
const songsJson = enabled ? JSON.stringify(songs) : "[]";
const api = conf?.api || "https://api.injahow.cn/meting/";
const fallbackApis = Array.isArray(conf?.fallbackApis) ? conf.fallbackApis : [];
const apisJson = JSON.stringify([...new Set([api, ...fallbackApis].filter(Boolean))]);
const volume = String(conf?.volume ?? 0.55);
const title = conf?.panelTitle || "华语金曲电台";
const subtitle = conf?.panelSubtitle || "80 / 90 / 00 经典";
const minDurationSec = String(conf?.minDurationSec ?? 90);
/** 缓存有效期（小时），代理 URL 会过期，不宜过长 */
const cacheHours = String(conf?.cacheHours ?? 6);
---

{
	enabled && (
		<div
			id="qingge-music"
			class="qm is-collapsed"
			aria-label="音乐播放器"
			data-songs={songsJson}
			data-apis={apisJson}
			data-volume={volume}
			data-min-duration={minDurationSec}
			data-cache-hours={cacheHours}
		>
			{/* 默认：圆盘 FAB */}
			<button type="button" class="qm__fab" id="qm-toggle" title="打开华语金曲电台" aria-expanded="false">
				<span class="qm__fab-ring" aria-hidden="true" />
				<span class="qm__fab-disc" aria-hidden="true">
					<span class="qm__fab-note">♪</span>
					<span class="qm__fab-eq"><i /><i /><i /><i /></span>
				</span>
			</button>

			{/* 精简迷你条：仅在面板内点「精简模式」后显示 */}
			<div class="qm__mini" id="qm-mini" role="group" aria-label="电台精简控制" hidden>
				<button type="button" class="qm__mini-cover" id="qm-mini-play" aria-label="播放">
					<img id="qm-mini-cover" class="qm__mini-cover-img" alt="" hidden />
					<span class="qm__mini-cover-fallback" id="qm-mini-cover-fallback" aria-hidden="true">♪</span>
					<span class="qm__mini-play-icon" id="qm-mini-icon-play" aria-hidden="true" />
					<span class="qm__mini-pause-icon" id="qm-mini-icon-pause" aria-hidden="true" hidden />
				</button>
				<button type="button" class="qm__mini-meta" id="qm-mini-expand-meta" title="打开完整电台">
					<span class="qm__mini-song" id="qm-mini-song">华语金曲电台</span>
					<span class="qm__mini-artist" id="qm-mini-artist">点封面播放 · 点此展开</span>
				</button>
				<div class="qm__mini-actions">
					<button type="button" class="qm__mini-nav" id="qm-mini-prev" aria-label="上一首" title="上一首">
						<span class="qm__nav-prev" aria-hidden="true" />
					</button>
					<button type="button" class="qm__mini-nav" id="qm-mini-next" aria-label="下一首" title="下一首">
						<span class="qm__nav-next" aria-hidden="true" />
					</button>
					<button type="button" class="qm__mini-expand" id="qm-mini-open-full" title="完整模式" aria-label="打开完整电台">
						<span class="qm__mini-expand-icon" aria-hidden="true" />
					</button>
					<button type="button" class="qm__mini-close" id="qm-mini-close" title="收起" aria-label="收起电台">✕</button>
				</div>
			</div>

			<div class="qm__panel" id="qm-panel" role="dialog" aria-label={title}>
				<div class="qm__panel-bg" aria-hidden="true" />
				<div class="qm__panel-inner">
					<header class="qm__head">
						<div>
							<p class="qm__eyebrow">{subtitle}</p>
							<h2 class="qm__title">{title}</h2>
						</div>
						<div class="qm__head-actions">
							<button type="button" class="qm__playback-mode-btn" id="qm-playback-mode" title="播放模式：顺序" aria-label="播放模式：顺序">
								<span id="qm-playback-mode-label">顺序</span>
							</button>
							<button type="button" class="qm__compact-btn" id="qm-compact" title="精简模式" aria-label="切换到精简模式">
								精简模式
							</button>
							<button type="button" class="qm__close" id="qm-close" aria-label="收起">✕</button>
						</div>
					</header>

					<div class="qm__loading" id="qm-loading" hidden>
						<div class="qm__orbit" aria-hidden="true"><span /><span /><span /></div>
						<p class="qm__loading-title" id="qm-loading-title">正在加载歌单</p>
						<p class="qm__loading-sub" id="qm-loading-sub">首次加载后会缓存，刷新不用重来</p>
						<div class="qm__track"><div class="qm__track-fill" id="qm-loading-bar" /></div>
						<p class="qm__loading-pct" id="qm-loading-pct">0%</p>
					</div>

					<div class="qm__ready" id="qm-ready" hidden>
						{/* 一行：封面(+播放) | 歌名/歌手 + 上一首/进度/下一首 */}
						<div class="qm__card">
							<button type="button" class="qm__cover-btn" id="qm-play" aria-label="播放">
								<img id="qm-cover" class="qm__cover-img" alt="" />
								<span class="qm__cover-fallback" id="qm-cover-fallback" aria-hidden="true">♪</span>
								<span class="qm__cover-mask" aria-hidden="true" />
								<span class="qm__cover-icon qm__cover-icon--play" id="qm-icon-play" aria-hidden="true" />
								<span class="qm__cover-icon qm__cover-icon--pause" id="qm-icon-pause" aria-hidden="true" hidden />
								<span class="qm__eq" aria-hidden="true"><i /><i /><i /></span>
							</button>

							<div class="qm__side">
								<div class="qm__meta">
									<p class="qm__song" id="qm-song">—</p>
									<p class="qm__artist" id="qm-artist">—</p>
								</div>
								<div class="qm__transport">
									<button type="button" class="qm__nav" id="qm-prev" aria-label="上一首" title="上一首">
										<span class="qm__nav-prev" aria-hidden="true" />
									</button>
									<div class="qm__seek-box">
										<input type="range" id="qm-seek" class="qm__seek" min="0" max="1000" value="0" step="1" aria-label="进度" />
										<div class="qm__times">
											<span id="qm-cur">0:00</span>
											<span id="qm-dur">0:00</span>
										</div>
									</div>
									<button type="button" class="qm__nav" id="qm-next" aria-label="下一首" title="下一首">
										<span class="qm__nav-next" aria-hidden="true" />
									</button>
								</div>
							</div>
						</div>

						<ul class="qm__list" id="qm-list" />
						<p class="qm__tip" id="qm-tip">点封面播放 · 点列表切歌</p>
					</div>
				</div>
			</div>
			<audio id="qm-audio" preload="metadata" />
		</div>
	)
}

{
	enabled && (
		<script>
          // @ts-nocheck
          import {
				MUSIC_CACHE_VERSION,
				classifyDuration,
				getApiFingerprint,
				getSongIdsFingerprint,
				normalizeApiSong,
			} from "../../scripts/music-playlist-utils.mjs";
			import {
				getNextIndex,
				nextPlaybackMode,
				PLAYBACK_MODE_LABELS,
				PLAYBACK_MODES,
			} from "../../scripts/music-playback-mode.mjs";

			(function () {
				var root = document.getElementById("qingge-music");
				if (!root || root.dataset.booted) return;
				root.dataset.booted = "1";

				var songs = [];
				try { songs = JSON.parse(root.getAttribute("data-songs") || "[]"); } catch (e) { songs = []; }
				if (!songs.length) return;

				var apiBases = [];
				try { apiBases = JSON.parse(root.getAttribute("data-apis") || "[]"); } catch (e) { apiBases = []; }
				apiBases = apiBases.filter(function (item) { return typeof item === "string" && item; });
				if (!apiBases.length) apiBases = ["https://api.injahow.cn/meting/"];
				var apiFingerprint = getApiFingerprint(apiBases[0], apiBases.slice(1));
				var apiCooldowns = {};
				var volume = parseFloat(root.getAttribute("data-volume") || "0.55");
				if (isNaN(volume)) volume = 0.55;
				var minDurationSec = parseFloat(root.getAttribute("data-min-duration") || "90");
				if (!isFinite(minDurationSec) || minDurationSec <= 0) minDurationSec = 90;
				var cacheHours = parseFloat(root.getAttribute("data-cache-hours") || "6");
				if (isNaN(cacheHours) || cacheHours < 0.5) cacheHours = 6;

				var CACHE_KEY = "qingge-music-playlist-" + MUSIC_CACHE_VERSION;

				var toggle = document.getElementById("qm-toggle");
				var miniExpandMeta = document.getElementById("qm-mini-expand-meta");
				var miniPlayBtn = document.getElementById("qm-mini-play");
				var miniPrevBtn = document.getElementById("qm-mini-prev");
				var miniNextBtn = document.getElementById("qm-mini-next");
				var miniSongEl = document.getElementById("qm-mini-song");
				var miniArtistEl = document.getElementById("qm-mini-artist");
				var miniCoverEl = document.getElementById("qm-mini-cover");
				var miniCoverFallback = document.getElementById("qm-mini-cover-fallback");
				var miniIconPlay = document.getElementById("qm-mini-icon-play");
				var miniIconPause = document.getElementById("qm-mini-icon-pause");
				var closeBtn = document.getElementById("qm-close");
				var loadingEl = document.getElementById("qm-loading");
				var readyEl = document.getElementById("qm-ready");
				var loadingTitle = document.getElementById("qm-loading-title");
				var loadingSub = document.getElementById("qm-loading-sub");
				var loadingBar = document.getElementById("qm-loading-bar");
				var loadingPct = document.getElementById("qm-loading-pct");
				var listEl = document.getElementById("qm-list");
				var tipEl = document.getElementById("qm-tip");
				var songEl = document.getElementById("qm-song");
				var artistEl = document.getElementById("qm-artist");
				var coverEl = document.getElementById("qm-cover");
				var coverFallback = document.getElementById("qm-cover-fallback");
				var playBtn = document.getElementById("qm-play");
				var iconPlay = document.getElementById("qm-icon-play");
				var iconPause = document.getElementById("qm-icon-pause");
				var seek = document.getElementById("qm-seek");
				var curEl = document.getElementById("qm-cur");
				var durEl = document.getElementById("qm-dur");
				var prevBtn = document.getElementById("qm-prev");
				var nextBtn = document.getElementById("qm-next");
				var audio = document.getElementById("qm-audio");

				var songStates = songs.map(function (meta) {
					return { meta: meta, status: "loading", item: null, reason: "" };
				});
				var loaded = [];
				var index = 0;
				var seeking = false;
				var loadPromise = null;
				var shouldBePlaying = false;
				var resumeTimer = 0;
				var recovering = false;

				function songIdsFingerprint() { return getSongIdsFingerprint(songs); }

				function syncLoaded() {
					loaded = songStates
						.filter(function (state) { return state.status === "ready" && state.item; })
						.map(function (state) { return state.item; });
					if (loaded.length && index >= loaded.length) index = 0;
				}

				function readyIndexForState(state) {
					var readyIndex = 0;
					for (var i = 0; i < songStates.length; i++) {
						if (songStates[i] === state) return state.status === "ready" ? readyIndex : -1;
						if (songStates[i].status === "ready") readyIndex++;
					}
					return -1;
				}

				function stateLabel(state) {
					if (state.status === "ready") return "可播放";
					if (state.status === "short") return "非完整音源 · 重试";
					if (state.status === "failed") return "音源暂不可用 · 重试";
					return "正在获取音源";
				}

				function readCache() {
					try {
						var raw = localStorage.getItem(CACHE_KEY);
						if (!raw) return null;
						var data = JSON.parse(raw);
						if (!data || data.version !== MUSIC_CACHE_VERSION || !data.items || !data.items.length) return null;
						if (data.api !== apiFingerprint) return null;
						if (data.ids !== songIdsFingerprint()) return null;
						var age = Date.now() - (data.ts || 0);
						if (age > cacheHours * 3600 * 1000) return null;
						return data.items;
					} catch (e) {
						return null;
					}
				}

				function writeCache(items) {
					try {
						localStorage.setItem(
							CACHE_KEY,
							JSON.stringify({
								version: MUSIC_CACHE_VERSION,
								ts: Date.now(),
								api: apiFingerprint,
								ids: songIdsFingerprint(),
								items: items,
							}),
						);
					} catch (e) {}
				}

				var miniEl = document.getElementById("qm-mini");
				var compactBtn = document.getElementById("qm-compact");
				var miniOpenFull = document.getElementById("qm-mini-open-full");
				var miniCloseBtn = document.getElementById("qm-mini-close");
				var MODE_KEY = "qingge-music-mode";
				var playbackModeBtn = document.getElementById("qm-playback-mode");
				var playbackModeLabel = document.getElementById("qm-playback-mode-label");
				var PLAYBACK_MODE_KEY = "qingge-music-playback-mode";
				var playbackMode = "sequence";

				try {
					var storedPlaybackMode = localStorage.getItem(PLAYBACK_MODE_KEY);
					if (PLAYBACK_MODES.includes(storedPlaybackMode)) playbackMode = storedPlaybackMode;
				} catch (e) {}

				function syncPlaybackModeButton() {
					var label = PLAYBACK_MODE_LABELS[playbackMode] || PLAYBACK_MODE_LABELS.sequence;
					if (playbackModeLabel) playbackModeLabel.textContent = label;
					if (playbackModeBtn) {
						playbackModeBtn.title = "播放模式：" + label;
						playbackModeBtn.setAttribute("aria-label", "播放模式：" + label);
					}
				}

				function setPlaybackMode(nextMode) {
					playbackMode = PLAYBACK_MODES.includes(nextMode) ? nextMode : "sequence";
					try { localStorage.setItem(PLAYBACK_MODE_KEY, playbackMode); } catch (e) {}
					syncPlaybackModeButton();
				}

				syncPlaybackModeButton();
				if (playbackModeBtn) playbackModeBtn.addEventListener("click", function () {
					setPlaybackMode(nextPlaybackMode(playbackMode));
				});

				/** mode: 'fab' | 'full' | 'compact' */
				function setMode(mode) {
					var isFull = mode === "full";
					var isCompact = mode === "compact";
					root.classList.toggle("is-collapsed", mode === "fab");
					root.classList.toggle("is-open", isFull);
					root.classList.toggle("is-compact", isCompact);
					if (toggle) toggle.setAttribute("aria-expanded", isFull ? "true" : "false");
					if (miniEl) miniEl.hidden = !isCompact;
					try { localStorage.setItem(MODE_KEY, mode); } catch (e) {}
					if (isFull || isCompact) ensureLoaded();
				}
				if (toggle) toggle.addEventListener("click", function () {
					setMode("full");
				});
				if (compactBtn) compactBtn.addEventListener("click", function () {
					setMode("compact");
				});
				if (miniExpandMeta) miniExpandMeta.addEventListener("click", function () {
					setMode("full");
				});
				if (miniOpenFull) miniOpenFull.addEventListener("click", function () {
					setMode("full");
				});
				if (miniCloseBtn) miniCloseBtn.addEventListener("click", function () {
					setMode("fab");
				});
				if (closeBtn) closeBtn.addEventListener("click", function () { setMode("fab"); });

				function fmt(t) {
					if (!isFinite(t) || t < 0) return "0:00";
					var m = Math.floor(t / 60);
					var s = Math.floor(t % 60);
					return m + ":" + String(s).padStart(2, "0");
				}

				function setPlayingUI(on) {
					root.classList.toggle("is-playing", !!on);
					if (iconPlay) iconPlay.hidden = !!on;
					if (iconPause) iconPause.hidden = !on;
					if (playBtn) playBtn.setAttribute("aria-label", on ? "暂停" : "播放");
					if (miniIconPlay) miniIconPlay.hidden = !!on;
					if (miniIconPause) miniIconPause.hidden = !on;
					if (miniPlayBtn) miniPlayBtn.setAttribute("aria-label", on ? "暂停" : "播放");
				}
				function stopPlaybackIntent() {
					shouldBePlaying = false;
					setPlayingUI(false);
				}

				function setLoadProgress(done, total, readyCount) {
					var ratio = total ? done / total : 0;
					if (loadingBar) loadingBar.style.width = Math.round(ratio * 100) + "%";
					if (loadingPct) loadingPct.textContent = Math.round(ratio * 100) + "%";
					if (loadingTitle) loadingTitle.textContent = done < total ? "正在加载歌单" : "即将完成";
					if (loadingSub) loadingSub.textContent = readyCount + " 首可播 · " + done + " / " + total;
				}

				function showReady() {
					if (loadingEl) loadingEl.hidden = true;
					if (readyEl) readyEl.hidden = false;
				}
				function showLoading() {
					if (loadingEl) loadingEl.hidden = false;
					if (readyEl) readyEl.hidden = true;
				}

				function setNow(item) {
					if (!item) return;
					if (songEl) songEl.textContent = item.name || "未知歌曲";
					if (artistEl) artistEl.textContent = item.artist || "";
					if (miniSongEl) miniSongEl.textContent = item.name || "未知歌曲";
					if (miniArtistEl) miniArtistEl.textContent = item.artist || "华语金曲电台";
					if ("mediaSession" in navigator && "MediaMetadata" in window) {
						try {
							navigator.mediaSession.metadata = new MediaMetadata({
								title: item.name || "华语金曲",
								artist: item.artist || "",
								artwork: item.cover ? [{ src: item.cover }] : [],
							});
						} catch (e) {}
					}
					if (coverEl && coverFallback) {
						if (item.cover) {
							coverEl.onload = function () {
								coverEl.style.display = "block";
								coverFallback.style.display = "none";
							};
							coverEl.onerror = function () {
								coverEl.style.display = "none";
								coverFallback.style.display = "grid";
							};
							coverEl.src = item.cover;
							coverEl.style.display = "block";
							coverFallback.style.display = "none";
						} else {
							coverEl.removeAttribute("src");
							coverEl.style.display = "none";
							coverFallback.style.display = "grid";
						}
					}
					if (miniCoverEl && miniCoverFallback) {
						if (item.cover) {
							miniCoverEl.onload = function () {
								miniCoverEl.hidden = false;
								miniCoverFallback.style.display = "none";
							};
							miniCoverEl.onerror = function () {
								miniCoverEl.hidden = true;
								miniCoverFallback.style.display = "grid";
							};
							miniCoverEl.src = item.cover;
							miniCoverEl.hidden = false;
							miniCoverFallback.style.display = "none";
						} else {
							miniCoverEl.removeAttribute("src");
							miniCoverEl.hidden = true;
							miniCoverFallback.style.display = "grid";
						}
					}
				}

				function highlight(i) {
					if (!listEl) return;
					var items = listEl.querySelectorAll(".qm__item");
					var activeItem = null;
					for (var k = 0; k < items.length; k++) {
						var isActive = Number(items[k].getAttribute("data-playable-index")) === i;
						items[k].classList.toggle("is-active", isActive);
						if (isActive) activeItem = items[k];
					}
					if (activeItem) activeItem.scrollIntoView({ block: "nearest" });
				}

				function buildList() {
					if (!listEl) return;
					listEl.innerHTML = "";
					for (var i = 0; i < songStates.length; i++) {
						(function (stateIndex) {
							var state = songStates[stateIndex];
							var s = state.item || state.meta;
							var playableIndex = readyIndexForState(state);
							var li = document.createElement("li");
							li.className = "qm__item" + (state.status === "ready" ? "" : " is-unavailable");
							li.setAttribute("data-playable-index", playableIndex >= 0 ? String(playableIndex) : "-1");
							li.innerHTML = '<span class="qm__idx"></span><span class="qm__item-body"><span class="qm__item-title"></span><span class="qm__item-artist"></span></span><span class="qm__item-status"></span>';
							li.querySelector(".qm__idx").textContent = String(stateIndex + 1);
							li.querySelector(".qm__item-title").textContent = s.name || s.title || "未知歌曲";
							li.querySelector(".qm__item-artist").textContent = s.artist || "";
							li.querySelector(".qm__item-status").textContent = stateLabel(state);
							if (state.reason) li.title = state.reason;
							if (playableIndex >= 0) {
								li.addEventListener("click", function () { playIndex(playableIndex, true); });
							} else if (state.status !== "loading") {
								li.addEventListener("click", function () { retrySong(stateIndex); });
							}
							listEl.appendChild(li);
						})(i);
					}
				}

				function apiUrl(base, type, id) {
					var join = base.indexOf("?") >= 0 ? "&" : "?";
					return base + join + "server=netease&type=" + encodeURIComponent(type) + "&id=" + encodeURIComponent(id);
				}

				function apiOnCooldown(base) {
					return Number(apiCooldowns[base] || 0) > Date.now();
				}

				function probeAudio(item) {
					return new Promise(function (resolve) {
						var probe = new Audio();
						var settled = false;
						var timer = window.setTimeout(function () {
							finish({ status: "failed", reason: "metadata-timeout" });
						}, 12000);
						function finish(result) {
							if (settled) return;
							settled = true;
							window.clearTimeout(timer);
							probe.onloadedmetadata = null;
							probe.onerror = null;
							probe.src = "";
							resolve(result);
						}
						probe.preload = "metadata";
						probe.onloadedmetadata = function () {
							var duration = Number(probe.duration);
							var state = classifyDuration(duration, minDurationSec);
							if (state === "short") finish({ status: "short", reason: "duration-too-short", duration: duration });
							else if (state === "ready") finish({ status: "ready", duration: duration });
							else finish({ status: "failed", reason: "invalid-duration" });
						};
						probe.onerror = function () { finish({ status: "failed", reason: "audio-error" }); };
						probe.src = item.url;
						probe.load();
					});
				}

				function fetchSongFromApi(meta, base) {
					var controller = new AbortController();
					var timer = window.setTimeout(function () { controller.abort(); }, 12000);
					return fetch(apiUrl(base, "song", meta.id), { credentials: "omit", signal: controller.signal })
						.then(function (r) {
							if (r.status === 429) {
								var retryAfter = Number(r.headers.get("retry-after")) || 1;
								apiCooldowns[base] = Date.now() + Math.min(retryAfter, 60) * 1000;
								throw new Error("rate limited");
							}
							if (!r.ok) throw new Error("http " + r.status);
							return r.json();
						})
						.then(function (data) {
							var item = normalizeApiSong(meta, data);
							if (!item) return { status: "failed", reason: "no-url" };
							return probeAudio(item).then(function (result) {
								if (result.status === "ready") {
									item.duration = result.duration;
									return { status: "ready", item: item };
								}
								return result;
							});
						})
						.finally(function () { window.clearTimeout(timer); });
				}

				function fetchSong(meta) {
					var apiIndex = 0;
					var failures = [];
					function tryNextApi() {
						while (apiIndex < apiBases.length && apiOnCooldown(apiBases[apiIndex])) apiIndex++;
						if (apiIndex >= apiBases.length) {
							var shortFailure = failures.find(function (failure) { return failure.status === "short"; });
							return Promise.resolve(shortFailure || { status: "failed", reason: "all-apis-failed" });
						}
						var base = apiBases[apiIndex++];
						return fetchSongFromApi(meta, base).then(function (result) {
							if (result && result.status === "ready") return result;
							if (result) failures.push(result);
							return tryNextApi();
						}).catch(function (error) {
							failures.push({ status: "failed", reason: error?.message || "request-failed" });
							return tryNextApi();
						});
					}
					return tryNextApi();
				}

				/** 单曲 URL 失效时重新解析 */
				function refreshSongUrl(item) {
					if (!item || !item.id) return Promise.resolve(null);
					var meta = null;
					for (var i = 0; i < songs.length; i++) {
						if (String(songs[i].id) === String(item.id)) { meta = songs[i]; break; }
					}
					if (!meta) meta = { id: item.id, title: item.name, artist: item.artist };
					return fetchSong(meta).then(function (result) {
						if (!result || result.status !== "ready" || !result.item) return null;
						var fresh = result.item;
						item.url = fresh.url;
						item.duration = fresh.duration;
						if (fresh.cover) item.cover = fresh.cover;
						writeCache(loaded);
						return item;
					});
				}

				function playIndex(i, autoplay) {
					if (!loaded.length) return;
					index = ((i % loaded.length) + loaded.length) % loaded.length;
					var item = loaded[index];
					setNow(item);
					highlight(index);
					if (!audio) return;
					if (audio.getAttribute("src") !== item.url) {
						audio.src = item.url;
					}
					if (autoplay) {
						shouldBePlaying = true;
						audio.play().then(function () { setPlayingUI(true); }).catch(function () {
							// URL 可能过期：刷新后再播
							refreshSongUrl(item).then(function (fresh) {
								if (!fresh) { stopPlaybackIntent(); return; }
								audio.src = fresh.url;
								audio.play().then(function () { setPlayingUI(true); }).catch(function () { stopPlaybackIntent(); });
							});
						});
					}
				}

				function togglePlay() {
					if (!audio || !loaded.length) return;
					if (!audio.getAttribute("src")) playIndex(index, true);
					else if (audio.paused) {
						shouldBePlaying = true;
						audio.play().then(function () { setPlayingUI(true); }).catch(function () {
							refreshSongUrl(loaded[index]).then(function (fresh) {
								if (!fresh) { stopPlaybackIntent(); return; }
								audio.src = fresh.url;
								audio.play().then(function () { setPlayingUI(true); }).catch(function () { stopPlaybackIntent(); });
							});
						});
					} else {
						shouldBePlaying = false;
						audio.pause();
						setPlayingUI(false);
					}
				}

				if (playBtn) playBtn.addEventListener("click", togglePlay);
				if (prevBtn) prevBtn.addEventListener("click", function () { playIndex(index - 1, true); });
				if (nextBtn) nextBtn.addEventListener("click", function () { playIndex(index + 1, true); });
				if (miniPlayBtn) miniPlayBtn.addEventListener("click", function () {
					ensureLoaded().then(function () { togglePlay(); });
				});
				if (miniPrevBtn) miniPrevBtn.addEventListener("click", function () {
					ensureLoaded().then(function () { playIndex(index - 1, true); });
				});
				if (miniNextBtn) miniNextBtn.addEventListener("click", function () {
					ensureLoaded().then(function () { playIndex(index + 1, true); });
				});

