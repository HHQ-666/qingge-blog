---
/**
 * 华语金曲播放器
 * - 封面与「上一首/进度/下一首」同一行
 * - localStorage 缓存歌单，刷新页面不重复探测
 * - 播放叠在封面；仅音柱动画
 */
import { funConfig } from "../../config";

const conf = funConfig.musicPlayer;
const songs = conf?.songs?.length ? conf.songs : [];
const enabled = Boolean(conf?.enable && songs.length);
const songsJson = enabled ? JSON.stringify(songs) : "[]";
const api = conf?.api || "https://api.qijieya.cn/meting/";
const volume = String(conf?.volume ?? 0.55);
const title = conf?.panelTitle || "华语金曲电台";
const subtitle = conf?.panelSubtitle || "80 / 90 / 00 经典";
/** 缓存有效期（小时），代理 URL 会过期，不宜过长 */
const cacheHours = String(conf?.cacheHours ?? 6);
---

{
	enabled && (
		<div
			id="qingge-music"
			class="qm is-collapsed"
			aria-label="音乐播放器"
			data-songs={songsJson}
			data-api={api}
			data-volume={volume}
			data-cache-hours={cacheHours}
		>
			<button type="button" class="qm__fab" id="qm-toggle" title="打开华语金曲电台" aria-expanded="false">
				<span class="qm__fab-ring" aria-hidden="true" />
				<span class="qm__fab-disc" aria-hidden="true">
					<span class="qm__fab-note">♪</span>
					<span class="qm__fab-eq"><i /><i /><i /><i /></span>
				</span>
			</button>

			<div class="qm__panel" id="qm-panel" role="dialog" aria-label={title}>
				<div class="qm__panel-bg" aria-hidden="true" />
				<div class="qm__panel-inner">
					<header class="qm__head">
						<div>
							<p class="qm__eyebrow">{subtitle}</p>
							<h2 class="qm__title">{title}</h2>
						</div>
						<button type="button" class="qm__close" id="qm-close" aria-label="收起">✕</button>
					</header>

					<div class="qm__loading" id="qm-loading" hidden>
						<div class="qm__orbit" aria-hidden="true"><span /><span /><span /></div>
						<p class="qm__loading-title" id="qm-loading-title">正在加载歌单</p>
						<p class="qm__loading-sub" id="qm-loading-sub">首次加载后会缓存，刷新不用重来</p>
						<div class="qm__track"><div class="qm__track-fill" id="qm-loading-bar" /></div>
						<p class="qm__loading-pct" id="qm-loading-pct">0%</p>
					</div>

					<div class="qm__ready" id="qm-ready" hidden>
						{/* 一行：封面(+播放) | 歌名/歌手 + 上一首/进度/下一首 */}
						<div class="qm__card">
							<button type="button" class="qm__cover-btn" id="qm-play" aria-label="播放">
								<img id="qm-cover" class="qm__cover-img" alt="" />
								<span class="qm__cover-fallback" id="qm-cover-fallback" aria-hidden="true">♪</span>
								<span class="qm__cover-mask" aria-hidden="true" />
								<span class="qm__cover-icon qm__cover-icon--play" id="qm-icon-play" aria-hidden="true" />
								<span class="qm__cover-icon qm__cover-icon--pause" id="qm-icon-pause" aria-hidden="true" hidden />
								<span class="qm__eq" aria-hidden="true"><i /><i /><i /></span>
							</button>

							<div class="qm__side">
								<div class="qm__meta">
									<p class="qm__song" id="qm-song">—</p>
									<p class="qm__artist" id="qm-artist">—</p>
								</div>
								<div class="qm__transport">
									<button type="button" class="qm__nav" id="qm-prev" aria-label="上一首" title="上一首">
										<span class="qm__nav-prev" aria-hidden="true" />
									</button>
									<div class="qm__seek-box">
										<input type="range" id="qm-seek" class="qm__seek" min="0" max="1000" value="0" step="1" aria-label="进度" />
										<div class="qm__times">
											<span id="qm-cur">0:00</span>
											<span id="qm-dur">0:00</span>
										</div>
									</div>
									<button type="button" class="qm__nav" id="qm-next" aria-label="下一首" title="下一首">
										<span class="qm__nav-next" aria-hidden="true" />
									</button>
								</div>
							</div>
						</div>

						<ul class="qm__list" id="qm-list" />
						<p class="qm__tip" id="qm-tip">点封面播放 · 点列表切歌</p>
					</div>
				</div>
			</div>
			<audio id="qm-audio" preload="metadata" />
		</div>
	)
}

{
	enabled && (
		<script is:inline>
			(function () {
				var root = document.getElementById("qingge-music");
				if (!root || root.dataset.booted) return;
				root.dataset.booted = "1";

				var songs = [];
				try { songs = JSON.parse(root.getAttribute("data-songs") || "[]"); } catch (e) { songs = []; }
				if (!songs.length) return;

				var apiBase = root.getAttribute("data-api") || "https://api.qijieya.cn/meting/";
				var volume = parseFloat(root.getAttribute("data-volume") || "0.55");
				if (isNaN(volume)) volume = 0.55;
				var cacheHours = parseFloat(root.getAttribute("data-cache-hours") || "6");
				if (isNaN(cacheHours) || cacheHours < 0.5) cacheHours = 6;

				var CACHE_KEY = "qingge-music-playlist-v2";

				var toggle = document.getElementById("qm-toggle");
				var closeBtn = document.getElementById("qm-close");
				var loadingEl = document.getElementById("qm-loading");
				var readyEl = document.getElementById("qm-ready");
				var loadingTitle = document.getElementById("qm-loading-title");
				var loadingSub = document.getElementById("qm-loading-sub");
				var loadingBar = document.getElementById("qm-loading-bar");
				var loadingPct = document.getElementById("qm-loading-pct");
				var listEl = document.getElementById("qm-list");
				var tipEl = document.getElementById("qm-tip");
				var songEl = document.getElementById("qm-song");
				var artistEl = document.getElementById("qm-artist");
				var coverEl = document.getElementById("qm-cover");
				var coverFallback = document.getElementById("qm-cover-fallback");
				var playBtn = document.getElementById("qm-play");
				var iconPlay = document.getElementById("qm-icon-play");
				var iconPause = document.getElementById("qm-icon-pause");
				var seek = document.getElementById("qm-seek");
				var curEl = document.getElementById("qm-cur");
				var durEl = document.getElementById("qm-dur");
				var prevBtn = document.getElementById("qm-prev");
				var nextBtn = document.getElementById("qm-next");
				var audio = document.getElementById("qm-audio");

				var loaded = [];
				var index = 0;
				var seeking = false;
				var loadPromise = null;
				var shouldBePlaying = false;
				var resumeTimer = 0;
				var recovering = false;

				function songIdsFingerprint() {
					return songs.map(function (s) { return s.id; }).join(",");
				}

				function readCache() {
					try {
						var raw = localStorage.getItem(CACHE_KEY);
						if (!raw) return null;
						var data = JSON.parse(raw);
						if (!data || !data.items || !data.items.length) return null;
						if (data.api !== apiBase) return null;
						if (data.ids !== songIdsFingerprint()) return null;
						var age = Date.now() - (data.ts || 0);
						if (age > cacheHours * 3600 * 1000) return null;
						return data.items;
					} catch (e) {
						return null;
					}
				}

				function writeCache(items) {
					try {
						localStorage.setItem(
							CACHE_KEY,
							JSON.stringify({
								ts: Date.now(),
								api: apiBase,
								ids: songIdsFingerprint(),
								items: items,
							}),
						);
					} catch (e) {}
				}

				function setOpen(open) {
					root.classList.toggle("is-collapsed", !open);
					root.classList.toggle("is-open", open);
					if (toggle) toggle.setAttribute("aria-expanded", open ? "true" : "false");
					if (open) ensureLoaded();
				}
				if (toggle) toggle.addEventListener("click", function () {
					setOpen(root.classList.contains("is-collapsed"));
				});
				if (closeBtn) closeBtn.addEventListener("click", function () { setOpen(false); });

				function fmt(t) {
					if (!isFinite(t) || t < 0) return "0:00";
					var m = Math.floor(t / 60);
					var s = Math.floor(t % 60);
					return m + ":" + String(s).padStart(2, "0");
				}

				function setPlayingUI(on) {
					root.classList.toggle("is-playing", !!on);
					if (iconPlay) iconPlay.hidden = !!on;
					if (iconPause) iconPause.hidden = !on;
					if (playBtn) playBtn.setAttribute("aria-label", on ? "暂停" : "播放");
				}
				function stopPlaybackIntent() {
					shouldBePlaying = false;
					setPlayingUI(false);
				}

				function setLoadProgress(done, total, readyCount) {
					var ratio = total ? done / total : 0;
					if (loadingBar) loadingBar.style.width = Math.round(ratio * 100) + "%";
					if (loadingPct) loadingPct.textContent = Math.round(ratio * 100) + "%";
					if (loadingTitle) loadingTitle.textContent = done < total ? "正在加载歌单" : "即将完成";
					if (loadingSub) loadingSub.textContent = readyCount + " 首可播 · " + done + " / " + total;
				}

				function showReady() {
					if (loadingEl) loadingEl.hidden = true;
					if (readyEl) readyEl.hidden = false;
				}
				function showLoading() {
					if (loadingEl) loadingEl.hidden = false;
					if (readyEl) readyEl.hidden = true;
				}

				function setNow(item) {
					if (!item) return;
					if (songEl) songEl.textContent = item.name || "未知歌曲";
					if (artistEl) artistEl.textContent = item.artist || "";
					if ("mediaSession" in navigator && "MediaMetadata" in window) {
						try {
							navigator.mediaSession.metadata = new MediaMetadata({
								title: item.name || "华语金曲",
								artist: item.artist || "",
								artwork: item.cover ? [{ src: item.cover }] : [],
							});
						} catch (e) {}
					}
					if (coverEl && coverFallback) {
						if (item.cover) {
							coverEl.onload = function () {
								coverEl.style.display = "block";
								coverFallback.style.display = "none";
							};
							coverEl.onerror = function () {
								coverEl.style.display = "none";
								coverFallback.style.display = "grid";
							};
							coverEl.src = item.cover;
							coverEl.style.display = "block";
							coverFallback.style.display = "none";
						} else {
							coverEl.removeAttribute("src");
							coverEl.style.display = "none";
							coverFallback.style.display = "grid";
						}
					}
				}

				function highlight(i) {
					if (!listEl) return;
					var items = listEl.querySelectorAll(".qm__item");
					for (var k = 0; k < items.length; k++) items[k].classList.toggle("is-active", k === i);
					if (items[i]) items[i].scrollIntoView({ block: "nearest" });
				}

				function buildList() {
					if (!listEl) return;
					listEl.innerHTML = "";
					for (var i = 0; i < loaded.length; i++) {
						(function (i) {
							var s = loaded[i];
							var li = document.createElement("li");
							li.className = "qm__item";
							li.innerHTML = '<span class="qm__idx"></span><span class="qm__item-body"><span class="qm__item-title"></span><span class="qm__item-artist"></span></span>';
							li.querySelector(".qm__idx").textContent = String(i + 1);
							li.querySelector(".qm__item-title").textContent = s.name;
							li.querySelector(".qm__item-artist").textContent = s.artist || "";
							li.addEventListener("click", function () { playIndex(i, true); });
							listEl.appendChild(li);
						})(i);
					}
				}

				function apiUrl(type, id) {
					var join = apiBase.indexOf("?") >= 0 ? "&" : "?";
					return apiBase + join + "server=netease&type=" + encodeURIComponent(type) + "&id=" + encodeURIComponent(id);
				}

				function fetchSong(meta) {
					return fetch(apiUrl("song", meta.id), { credentials: "omit" })
						.then(function (r) { if (!r.ok) throw new Error("http"); return r.json(); })
						.then(function (data) {
							var s = Array.isArray(data) ? data[0] : data;
							if (!s || !s.url) return null;
							var url = s.url;
							return fetch(url, { method: "GET", headers: { Range: "bytes=0-1" }, credentials: "omit" })
								.then(function (r) {
									var ct = (r.headers.get("content-type") || "").toLowerCase();
									if (ct.indexOf("html") >= 0) return null;
									var cr = r.headers.get("content-range") || "";
									var total = 0;
									if (cr.indexOf("/") >= 0) total = Number(cr.split("/").pop()) || 0;
									if (total > 0 && total < 800000) return null;
									return {
										id: meta.id,
										name: meta.title || s.name || s.title || meta.id,
										artist: meta.artist || s.artist || s.author || "",
										url: url,
										cover: s.pic || s.cover || "",
									};
								})
								.catch(function () {
									return {
										id: meta.id,
										name: meta.title || s.name || s.title || meta.id,
										artist: meta.artist || s.artist || s.author || "",
										url: url,
										cover: s.pic || s.cover || "",
									};
								});
						})
						.catch(function () { return null; });
				}

				/** 单曲 URL 失效时重新解析 */
				function refreshSongUrl(item) {
					if (!item || !item.id) return Promise.resolve(null);
					var meta = null;
					for (var i = 0; i < songs.length; i++) {
						if (String(songs[i].id) === String(item.id)) { meta = songs[i]; break; }
					}
					if (!meta) meta = { id: item.id, title: item.name, artist: item.artist };
					return fetchSong(meta).then(function (fresh) {
						if (!fresh) return null;
						item.url = fresh.url;
						if (fresh.cover) item.cover = fresh.cover;
						writeCache(loaded);
						return item;
					});
				}

				function playIndex(i, autoplay) {
					if (!loaded.length) return;
					index = ((i % loaded.length) + loaded.length) % loaded.length;
					var item = loaded[index];
					setNow(item);
					highlight(index);
					if (!audio) return;
					if (audio.getAttribute("src") !== item.url) {
						audio.src = item.url;
					}
					if (autoplay) {
						shouldBePlaying = true;
						audio.play().then(function () { setPlayingUI(true); }).catch(function () {
							// URL 可能过期：刷新后再播
							refreshSongUrl(item).then(function (fresh) {
								if (!fresh) { stopPlaybackIntent(); return; }
								audio.src = fresh.url;
								audio.play().then(function () { setPlayingUI(true); }).catch(function () { stopPlaybackIntent(); });
							});
						});
					}
				}

				function togglePlay() {
					if (!audio || !loaded.length) return;
					if (!audio.getAttribute("src")) playIndex(index, true);
					else if (audio.paused) {
						shouldBePlaying = true;
						audio.play().then(function () { setPlayingUI(true); }).catch(function () {
							refreshSongUrl(loaded[index]).then(function (fresh) {
								if (!fresh) { stopPlaybackIntent(); return; }
								audio.src = fresh.url;
								audio.play().then(function () { setPlayingUI(true); }).catch(function () { stopPlaybackIntent(); });
							});
						});
					} else {
						shouldBePlaying = false;
						audio.pause();
						setPlayingUI(false);
					}
				}

				if (playBtn) playBtn.addEventListener("click", togglePlay);
				if (prevBtn) prevBtn.addEventListener("click", function () { playIndex(index - 1, true); });
				if (nextBtn) nextBtn.addEventListener("click", function () { playIndex(index + 1, true); });

				if (audio) {
					audio.volume = volume;
					audio.addEventListener("play", function () { setPlayingUI(true); });
					audio.addEventListener("pause", function () {
						setPlayingUI(false);
						if (!shouldBePlaying || recovering || document.hidden || resumeTimer) return;
						resumeTimer = window.setTimeout(function () {
							resumeTimer = 0;
							if (shouldBePlaying && audio.paused && !document.hidden) {
								audio.play().catch(function () {});
							}
						}, 180);
					});
					audio.addEventListener("ended", function () { playIndex(index + 1, true); });
					audio.addEventListener("error", function () {
						var item = loaded[index];
						if (!item || recovering) return;
						refreshSongUrl(item).then(function (fresh) {
							if (!fresh) { stopPlaybackIntent(); return; }
							var wasPlaying = shouldBePlaying;
							recovering = true;
							audio.src = fresh.url;
							if (wasPlaying) {
								audio.play().then(function () { recovering = false; }).catch(function () {
									recovering = false;
									stopPlaybackIntent();
								});
							} else {
								recovering = false;
							}
						});
					});
					audio.addEventListener("timeupdate", function () {
						if (seeking || !seek) return;
						var d = audio.duration || 0;
						var c = audio.currentTime || 0;
						seek.value = d ? String(Math.round((c / d) * 1000)) : "0";
						if (curEl) curEl.textContent = fmt(c);
						if (durEl) durEl.textContent = fmt(d);
					});
					audio.addEventListener("loadedmetadata", function () {
						if (durEl) durEl.textContent = fmt(audio.duration || 0);
					});
					if ("mediaSession" in navigator) {
						try {
							navigator.mediaSession.setActionHandler("play", function () {
								shouldBePlaying = true;
								audio.play().catch(function () {});
							});
							navigator.mediaSession.setActionHandler("pause", function () {
								shouldBePlaying = false;
								audio.pause();
							});
							navigator.mediaSession.setActionHandler("previoustrack", function () { playIndex(index - 1, true); });
							navigator.mediaSession.setActionHandler("nexttrack", function () { playIndex(index + 1, true); });
						} catch (e) {}
					}
				}
				if (seek) {
					seek.addEventListener("pointerdown", function () { seeking = true; });
					seek.addEventListener("pointerup", function () { seeking = false; });
					seek.addEventListener("input", function () {
						if (!audio || !audio.duration) return;
						audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
						if (curEl) curEl.textContent = fmt(audio.currentTime);
					});
				}

				function applyLoaded(items, fromCache) {
					loaded = items;
					buildList();
					playIndex(0, false);
					showReady();
					if (tipEl) {
						tipEl.textContent = fromCache
							? "已从缓存恢复 " + loaded.length + " 首 · 点封面播放"
							: "可播放 " + loaded.length + " 首 · 点封面播放";
					}
				}

				function fetchAll() {
					showLoading();
					setLoadProgress(0, songs.length, 0);
					var i = 0;
					var concurrency = 3;
					var skipped = 0;
					var items = [];
					function next() {
						if (i >= songs.length) return Promise.resolve();
						var cur = songs[i++];
						var n = i;
						return fetchSong(cur).then(function (item) {
							if (item) items.push(item); else skipped++;
							setLoadProgress(n, songs.length, items.length);
							return next();
						});
					}
					var starters = [];
					for (var c = 0; c < concurrency; c++) starters.push(next());
					return Promise.all(starters).then(function () {
						if (!items.length) {
							if (loadingTitle) loadingTitle.textContent = "暂无可用音源";
							if (loadingSub) loadingSub.textContent = "可稍后重试或更换 musicPlayer.api";
							return;
						}
						writeCache(items);
						applyLoaded(items, false);
						if (tipEl && skipped) {
							tipEl.textContent = "可播放 " + items.length + " 首 · 已跳过 " + skipped + " 首 · 点封面播放";
						}
					});
				}

				function ensureLoaded() {
					// 已有数据：直接展示（修复缓存预热后打开面板空白）
					if (loaded.length) {
						if (listEl && !listEl.children.length) buildList();
						if (songEl && (songEl.textContent === "—" || !songEl.textContent)) {
							playIndex(index || 0, false);
						}
						showReady();
						return Promise.resolve();
					}
					if (loadPromise) return loadPromise;

					var cached = readCache();
					if (cached && cached.length) {
						applyLoaded(cached, true);
						loadPromise = Promise.resolve();
						return loadPromise;
					}

					loadPromise = fetchAll().catch(function (err) {
						console.error("[qingge-music] load failed", err);
						if (loadingTitle) loadingTitle.textContent = "加载失败";
						if (loadingSub) loadingSub.textContent = "请关闭后重试，或检查网络";
						loadPromise = null; // 允许重试
					});
					return loadPromise;
				}

				// 预读缓存到内存，打开面板时 ensureLoaded 会立刻 showReady
				var cachedBoot = readCache();
				if (cachedBoot && cachedBoot.length) {
					loaded = cachedBoot;
				} else if ("requestIdleCallback" in window) {
					requestIdleCallback(function () { ensureLoaded(); }, { timeout: 4000 });
				} else {
					setTimeout(function () { ensureLoaded(); }, 1200);
				}
			})();
		</script>
	)
}

{
	enabled && (
		<style is:global>
			#qingge-music.qm {
				position: fixed;
				right: 1.1rem;
				bottom: 1.1rem;
				z-index: 90;
				font-family: inherit;
			}

			.qm__fab {
				position: relative;
				width: 4.25rem; height: 4.25rem;
				border: none; padding: 0; background: transparent; cursor: pointer;
				filter: drop-shadow(0 12px 22px oklch(0.4 0.12 var(--hue) / 0.45));
				transition: transform 200ms ease;
			}
			.qm__fab:hover { transform: scale(1.06) translateY(-2px); }
			.qm.is-open .qm__fab { display: none; }
			.qm__fab-ring {
				position: absolute; inset: 0; border-radius: 50%;
				border: 2px solid oklch(0.78 0.1 var(--hue) / 0.5);
				animation: qm-pulse 2.4s ease-in-out infinite;
			}
			.qm__fab-disc {
				position: absolute; inset: 0.32rem; border-radius: 50%;
				background:
					radial-gradient(circle at 50% 50%, oklch(0.38 0.05 var(--hue)) 0 17%, transparent 18%),
					repeating-radial-gradient(circle at 50% 50%, oklch(0.16 0.02 var(--hue)) 0 2px, oklch(0.26 0.03 var(--hue)) 2px 4px);
