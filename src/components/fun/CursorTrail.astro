---
import { funConfig } from "../../config";
const enabled = funConfig.cursorTrail;
---

{
	enabled && (
		<script>
			(() => {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				if (window.matchMedia("(pointer: coarse)").matches) return;

				const colors = [
					"oklch(0.78 0.12 var(--hue))",
					"oklch(0.72 0.14 var(--hue))",
					"oklch(0.85 0.08 var(--hue))",
					"oklch(0.9 0.05 80)",
					"oklch(0.8 0.1 40)",
				];
				let last = 0;
				const gap = 28;

				function spawn(x: number, y: number) {
					const d = document.createElement("span");
					d.className = "cursor-spark";
					const size = 4 + Math.random() * 5;
					const color = colors[Math.floor(Math.random() * colors.length)];
					const dx = (Math.random() - 0.5) * 28;
					const dy = -12 - Math.random() * 24;
					d.style.cssText = [
						`left:${x}px`,
						`top:${y}px`,
						`width:${size}px`,
						`height:${size}px`,
						`background:${color}`,
						`--dx:${dx}px`,
						`--dy:${dy}px`,
					].join(";");
					document.body.appendChild(d);
					setTimeout(() => d.remove(), 700);
				}

				window.addEventListener(
					"pointermove",
					(e) => {
						const now = performance.now();
						if (now - last < gap) return;
						last = now;
						spawn(e.clientX, e.clientY);
					},
					{ passive: true },
				);
			})();
		</script>
	)
}

{
	enabled && (
		<style is:global>
			.cursor-spark {
				position: fixed;
				border-radius: 999px;
				pointer-events: none;
				z-index: 9998;
				opacity: 0.9;
				transform: translate(-50%, -50%);
				animation: cursor-spark-fly 700ms ease-out forwards;
				box-shadow: 0 0 8px oklch(0.8 0.1 var(--hue) / 0.45);
			}
			@keyframes cursor-spark-fly {
				0% {
					opacity: 0.95;
					transform: translate(-50%, -50%) scale(1);
				}
				100% {
					opacity: 0;
					transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0.2);
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.cursor-spark {
					display: none !important;
				}
			}
		</style>
	)
}
