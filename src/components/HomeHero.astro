---
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "../config";
import { url } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

const welcome = `欢迎来到${siteConfig.title}`;
const subtitle = siteConfig.subtitle;
const name = profileConfig.name;
const bio = profileConfig.bio;
const avatar = profileConfig.avatar || "";
---

<section
	class="card-base relative overflow-hidden rounded-[var(--radius-large)] mb-4 onload-animation home-hero"
	style="animation-delay: calc(var(--content-delay) + 0ms);"
	aria-label="欢迎区"
>
	<!-- soft warm glow -->
	<div class="home-hero__glow pointer-events-none absolute -top-24 -right-16 h-56 w-56 rounded-full opacity-60 blur-3xl"></div>
	<div class="home-hero__glow-soft pointer-events-none absolute -bottom-20 -left-10 h-44 w-44 rounded-full opacity-40 blur-3xl"></div>

	<div class="relative z-10 flex flex-col gap-3.5 sm:gap-5 px-4 py-4 sm:px-6 sm:py-7 md:px-9 md:py-8">
		<div class="flex items-start gap-3 sm:gap-4">
			{/* 移动端：头像；桌面：小屋图标（侧栏已有头像） */}
			<a
				href={url("/about/")}
				aria-label="关于我"
				class="home-hero__avatar lg:hidden shrink-0 overflow-hidden rounded-2xl active:scale-95"
			>
				<ImageWrapper
					src={avatar}
					alt={name}
					class="w-full h-full"
				/>
			</a>
			<div class="home-hero__icon hidden lg:flex shrink-0 h-12 w-12 items-center justify-center rounded-2xl">
				<Icon name="material-symbols:cottage-rounded" class="text-[1.75rem] text-[var(--primary)]" />
			</div>

			<div class="min-w-0 flex-1">
				<p class="mb-0.5 sm:mb-1 text-xs sm:text-sm font-medium tracking-wide text-[var(--primary)]">
					Hi，我是 {name}
				</p>
				<h1 class="text-lg sm:text-2xl md:text-3xl font-bold text-90 leading-snug">
					{welcome}
				</h1>
				<p class="mt-1 sm:mt-2 text-75 leading-relaxed max-w-2xl text-[0.86rem] sm:text-base">
					<span class="sm:hidden">{bio}</span>
					<span class="hidden sm:inline">
						{subtitle}。这里放着前端踩坑笔记、面试整理与日常思考——先看看湖光山色，再推门进来坐坐。
					</span>
				</p>
			</div>
		</div>

		<div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
			<a
				href={url("/archive/")}
				class="btn-regular home-hero__cta rounded-xl h-9 sm:h-10 px-3.5 sm:px-4 gap-1.5 sm:gap-2 text-sm sm:text-base font-semibold active:scale-95"
			>
				<Icon name="material-symbols:library-books-rounded" class="text-[1.1rem] sm:text-[1.15rem]" />
				全部文章
			</a>
			<a
				href={url("/about/")}
				class="btn-plain home-hero__ghost rounded-xl h-9 sm:h-10 px-3.5 sm:px-4 gap-1.5 sm:gap-2 text-sm sm:text-base font-semibold active:scale-95"
			>
				<Icon name="material-symbols:person-rounded" class="text-[1.1rem] sm:text-[1.15rem]" />
				关于我
			</a>
			{
				profileConfig.links.slice(0, 3).map((item) => (
					<a
						rel="me"
						aria-label={item.name}
						href={item.url}
						target="_blank"
						class="btn-plain rounded-xl h-9 w-9 sm:h-10 sm:w-10 active:scale-90"
						title={item.name}
					>
						<Icon name={item.icon} class="text-[1.2rem] sm:text-[1.25rem]" />
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.home-hero__avatar {
		width: 3.25rem;
		height: 3.25rem;
		box-shadow: inset 0 0 0 1px oklch(0.8 0.06 var(--hue) / 0.35);
	}
	@media (min-width: 640px) {
		.home-hero__avatar {
			width: 3.75rem;
			height: 3.75rem;
		}
	}
	.home-hero__glow {
		background: oklch(0.82 0.12 var(--hue) / 0.45);
	}
	.home-hero__glow-soft {
		background: oklch(0.88 0.08 var(--hue) / 0.35);
	}
	:global(.dark) .home-hero__glow {
		background: oklch(0.45 0.1 var(--hue) / 0.35);
	}
	:global(.dark) .home-hero__glow-soft {
		background: oklch(0.35 0.08 var(--hue) / 0.3);
	}
	.home-hero__icon {
		background: oklch(0.95 0.04 var(--hue));
		box-shadow: inset 0 0 0 1px oklch(0.8 0.06 var(--hue) / 0.35);
	}
	:global(.dark) .home-hero__icon {
		background: oklch(0.3 0.04 var(--hue));
		box-shadow: inset 0 0 0 1px oklch(0.55 0.08 var(--hue) / 0.25);
	}
	.home-hero {
		box-shadow:
			0 1px 0 oklch(0.7 0.04 var(--hue) / 0.08),
			0 12px 40px -20px oklch(0.55 0.1 var(--hue) / 0.35);
	}
	:global(.dark) .home-hero {
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.04),
			0 16px 40px -22px rgba(0, 0, 0, 0.45);
	}
</style>
